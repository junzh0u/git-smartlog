#!/usr/bin/env zsh
# Sapling-inspired smartlog using only git.
#
# Self-contained: a single file depending only on zsh and git, so it can be
# downloaded and run standalone — no other files from this repo are required. The
# uncommitted-changes node needs nothing external either: its stat block is
# computed by the in-file `uncommitted_stat` function. The one exception is
# -p/--prs, which shells out to the GitHub CLI (`gh`) — opt-in, and everything
# else keeps working without gh installed.
#
# Multi-call: this same file is also `git-smartstat`. Symlink it under that name
# (e.g. `ln -s git-smartlog git-smartstat`) and the git-smartstat name runs ONLY
# the uncommitted-changes stat — the body the wdir node draws under -c — as a
# standalone
# command (`git smartstat`). Dispatch is on the invocation name ($PROG) at the
# bottom; both names share `uncommitted_stat`, so there's no duplicated logic.
#
# Completion: completions/_git-smartlog, completions/_git-smartstat — keep in
# sync when adding/changing options. The _git-<name> naming makes them cover
# the `git smartlog` / `git smartstat` subcommand forms too.
#
# Views
#   - Single stack by default: renders the CURRENT HEAD's first-parent draft
#     chain plus its public base. Other local branches and draft heads do not
#     appear unless -b asks for them.
#   - Other branches (opt-in via -b/--branches): every other local branch
#     renders its COMPLETE first-parent stack. All heads' chains union into a
#     forest of draft trees, so a branch forking from a draft shows as a real
#     fork, and commits stacked ABOVE HEAD — a branch containing HEAD while
#     you're checked out mid-stack — appear too, with @ drawn mid-tree. At each
#     fork the spine child (the one on HEAD's path, else the newest subtree)
#     continues the column; each other child opens a column one level deeper
#     ("│ o" rows), newest first, closing with a ├─╯ bend right above the fork —
#     the contiguous-chain linearization borrowed from sapling's renderdag.
#     A branch merged into the trunk labels that commit instead of adding a
#     node; a branch whose same-name remote ref sits at the same commit shows
#     only the remote name (same rule as the active branch). Public commits
#     jumped over between fork points elide to a dotted ╷ spine, and a tree
#     bends ╭─╯ off a dotted-or-empty spine but forks ├─╯ off a solid one. When
#     the tree is dirty the wdir node draws directly above HEAD at HEAD's depth.
#   - Long subjects are shown in full — never truncated to the terminal width,
#     so a long one wraps instead of ending in an ellipsis.
#   - Uncommitted changes are always shown: a dirty working tree draws a
#     synthetic node on top of HEAD, one line carrying its totals (-c adds the
#     per-file body, see Format below). Borrowed from jj, which treats the
#     working copy as a commit in its own right.
#   - Optional full headers: with -f/--full, every commit shows its author and
#     subject — including public commits by other people, which render
#     metadata-only by default.
#
# Layout
#   - Public base: the nearest public ancestor of HEAD. Candidate trunks are
#     REMOTE-tracking refs only (origin/HEAD, upstream/HEAD, origin/main,
#     origin/master, upstream/main, upstream/master); among those, the one whose
#     merge-base with HEAD is closest to HEAD wins (mirrors sapling's "nearest
#     public ancestor" and tolerates a stale fork remote). NOT @{u} or a local
#     branch — a pushed feature branch's @{u}, or the local main/master you're
#     sitting on, can equal HEAD and collapse the whole draft stack. @{u} then a
#     local main/master are last-resort fallbacks when no remote trunk exists.
#     That candidate list is the entire heuristic — a trunk named anything else
#     (develop, release/2.x), or one whose origin/HEAD was never set or went
#     stale after a rename, is only reachable via --base, which is why the flag
#     exists. --base redefines "public" for the run as AT OR BELOW that rev:
#     the rev is taken at your word, so ◆ there means "below the base", not
#     "pushed" (point it at a never-pushed local branch and that commit still
#     draws ◆). Only the auto-detected base is guaranteed to be a remote ref.
#   - Drafts: first-parent commits in `HEAD ^merge_base`, newest first
#   - Pushed drafts: a draft reachable from any remote-tracking ref draws ◇
#     instead of o — it's out there, so rewriting it costs a force-push.
#     Deliberately weaker than jj's immutability line, which excludes remote
#     bookmarks you track precisely because rewriting your own pushed branch is
#     routine; freezing a whole PR stack would be worse than saying nothing —
#     hence the middle glyph rather than ◆. One `git rev-list <draft heads>
#     --not --remotes` decides it; see the comment in main.
#   - Public window: one commit — base_ref (or merge_base if base is ahead of
#     HEAD's chain), with "~" for the history below it. -f streams that history
#     instead; there is no in-between, since the ╷ elision below already says
#     which commits a fork point jumped over.
#   - Draft trees (-b): all heads' chains union into trees; each tree renders
#     above its root's public fork point — spine child straight up the same
#     column, side subtrees one column deeper per fork level. With -b the public
#     window always anchors at the trunk tip, and the merge-base plus every
#     tree's fork point are added to it; commits jumped over between shown
#     publics render as a dotted ╷ spine
#
# Format per commit
#   <symbol>  <hash:10>  <reltime>  <author>  [<refs>]
#   │  [(empty) ]<subject>
#   │
#   - Symbol: a ramp of how set in stone the commit is — o a draft that's still
#     only yours, ◇ a draft already on a remote (rewriting costs a force-push),
#     ◆ a public commit. @ outranks all three: where the working copy is beats
#     what phase it's in. Borrowed from jj, whose node alphabet carries the
#     phase (@ working copy, ○ mutable, ◆ immutable); drafts stay `o` rather
#     than `○` because `o` is one column wide in every font and the contrast is
#     what matters. Shape, not color, because color can't carry this: the
#     graph's own palette leans on \e[33m vs \e[93m, which is one yellow in
#     Dracula and most 16-color themes — bold was doing all the work. Shape
#     also survives NO_COLOR, a pipe, and every text capture in the README,
#     none of which indentation alone can disambiguate (a -b side column is
#     indented too).
#   - Hash: HASH_WIDTH digits cut from %H, split at the shortest prefix that
#     uniquely names the commit — that prefix keeps the hash color, the rest
#     goes dim, so a row shows how much of it you'd have to type (jj's id
#     rendering). The unique length comes from a second %h fetched at
#     --abbrev=4 in the same `git log` pass, so it costs nothing; see
#     abbrev_hash, which also widens the display past HASH_WIDTH rather than
#     print an ambiguous hash in a repo that collides inside it. Color-only:
#     with the palette off the hash is the flat string it always was.
#   - (empty): a commit whose tree equals its first parent's (the empty tree for
#     a root commit) gets its subject prefixed with a dim "(empty)", and no -c
#     body — it changed nothing, so there is nothing to stat. Borrowed from jj.
#     Unlike the hash split this is text, not color, so it survives NO_COLOR —
#     a commit emptied by a rebase is otherwise indistinguishable from one still
#     carrying work, which is exactly the commit you'd want to drop. Decided
#     from %T, not a diff: main compares against the parent trees it already
#     fetched (one batched lookup covers parents outside the window), and the
#     -f tail holds each row one record behind, since in a first-parent walk the
#     record just read IS the previous row's parent.
#   - Uncommitted changes (node always on, body opt-in via -c): when the working
#     tree is dirty, a synthetic "Uncommitted changes" node is drawn on top of
#     HEAD. Its header carries compact totals ("2 files, +69 -2") and is all that
#     draws by default — the per-file body below is -c's, on the same footing as
#     every other commit's, so the default view stays one line per node however
#     dirty the tree is. That body is the per-file bars from `git diff --stat
#     HEAD`, with the stat's own trailing total dropped (it lives in the header,
#     which is why the header can stand alone). The totals are computed the same
#     way either way. Loose untracked files are folded into BOTH the
#     totals and the body via a throwaway index overlay (`git add -N` against a copy
#     of the index), so they show as new-file additions without touching the real
#     index. A wholly-untracked directory is NOT expanded: like `git status` it
#     collapses to a single "dir/ | N files" body line — counted as one file in the
#     totals, contributing no +/- lines. The header still matches the body: one
#     counted entry per body line.
#     Each body filename is prefixed with a one-letter change marker (from
#     `git diff --raw`, plus porcelain for conflicts): A added, ? untracked,
#     M modified, D deleted, R renamed, T typechange, S submodule, U unmerged;
#     marker and name are colored by kind (see the Colors note below), and an
#     executable-bit flip gets a trailing +x/-x hint. The body is grouped by marker
#     in that order (A ? M D R T S U), alphabetical within each group. The @ marker
#     moves to the node — that's where the working copy is — and HEAD drops to o
#     (keeps author/subject).
#     A submodule entry (marker S — so, being a body line, -c only) expands into
#     sub-lines under its stat line, in two groups of at most 10 lines each,
#     every group closing with a dim "… +N more" tail when it overflows (-f
#     lifts the cap — see Paging):
#       - its own UNCOMMITTED changes (the wdir node only — a -c commit body
#         has no working tree): this very stat block, recomputed with the
#         submodule as cwd, indented one level in — same markers, colors and
#         bars, and a dirty submodule inside it nests again. Without this a
#         merely dirty submodule says nothing at all: its sha is unchanged, so
#         git renders it as a bare "| 0".
#       - the commits its pointer gained or lost, from "git diff
#         --submodule=log", newest first — "›" for one gained, "‹" for one lost
#         (a rewind) — dim. A bump git can't summarize (commits not present
#         locally) adds none.
#     A clean submodule at an unchanged sha isn't in the diff at all; a clean
#     bump's S line still stands alone if git can't summarize it. Commit bodies
#     (-c) get the commit group only — a commit has no working tree.
#   - Commit changes (opt-in via -c/--changes): draws
#     every draft in the current stack its own per-file stat block (vs its first
#     parent; the empty tree for a root commit) under its subject row, clean or
#     dirty, closed by a dim "N files, +X -Y" total line — and the same body
#     under the wdir node, whose totals already live in its header. When HEAD
#     sits directly on the trunk (no drafts), it covers the public commit in
#     view instead (pair with -f to walk back through history). Bodies share
#     the wdir node's format, markers and colors ('?'/U can't occur in a
#     committed diff); an empty commit gets no body.
#   - Author: %al (email local-part, e.g. "junz")
#   - Refs: %D filtered to remote bookmarks plus the active local branch, shown
#     with a trailing "*" like sapling's active bookmark — but only when no remote
#     branch of the same name exists (else just the remote shows, e.g. master ->
#     origin/master); inactive local branches and tags are dropped
#   - PR numbers (opt-in via -p/--prs; needs the GitHub CLI `gh`): every branch
#     name a row displays — the active branch, a remote bookmark, or a -b
#     local — whose branch has a GitHub PR gets a trailing "#N" tag after the
#     refs, colored by PR state (see Colors) and deduped per PR number (a
#     local+remote pair tags once). On a color-capable TTY the tag is also an
#     OSC 8 hyperlink to the PR (same gate as the palette, so piped output
#     stays plain). One `gh pr list --state all` call (newest 200 PRs) maps
#     head branch -> PR up front; a branch with several PRs keeps an open one
#     over closed/merged, else the newest. The trunk's own branch name is
#     skipped — its long-merged PR would tag the base of every graph. The
#     call's ~1s+ API round-trip is cached per repo in the git dir
#     (smartlog-pr-cache) for $GIT_SMARTLOG_PR_TTL seconds (default 60; 0
#     forces a refetch), so only the first -p run in a while pays it. Missing
#     gh dies with a clear error; a failed listing (non-GitHub remote,
#     unauthenticated gh, offline) warns on stderr and renders from the stale
#     cache when one exists, else without tags.
#     -p is STICKY per repo: it drops a marker file in the git dir
#     (smartlog-pr-on), so later runs without the flag keep tagging PRs;
#     -P/--no-prs removes the marker and turns tagging off (winning over -p
#     when both are given). When tagging is on only via the marker, missing
#     gh downgrades from the -p die to a warning — a plain run must keep
#     working on a machine without gh.
#   - Last draft's subject line uses ╭─╯ instead of │ to bend into column 0
#   - Final line is ~ (truncation indicator)
#   - Compact public nodes (default; disable with -f/--full): a public
#     commit that is NOT HEAD and was authored by someone other than you renders
#     metadata-only (no author, no subject line). Mirrors sapling's
#     `sl_use_short_header`: short header iff `graphnode != @ && phase == public &&
#     username|email != author|email`. (Source: builtin_static/production.rs.) So
#     your own public commits and the @ commit still show author + subject in full.
#     -f/--full turns this off, showing full headers for every commit.
#
# Colors (ANSI; suppressed when stdout isn't a TTY or NO_COLOR is set)
#   - Draft hash: bright-yellow + bold (\e[93;1m) — applies to ALL drafts,
#     pushed or not; the o/◇ node carries that distinction instead
#   - Public hash: yellow (\e[33m). Note this differs from the draft color by
#     weight, not hue: \e[33m and \e[93m are one yellow in Dracula and most
#     16-color themes. That's survivable because ◆/o says it too — and it's
#     why no NEW distinction may be encoded as a hash color
#   - Hash digits past the unique prefix: dim (\e[2m), in both colors above
#   - "(empty)" subject prefix: dim (\e[2m) — but the word itself is text, so
#     the mark survives a palette-off run; only its dimming is a color
#   - HEAD's time/author/subject: magenta (\e[35m)
#   - Refs: remote bookmarks green (\e[32m); the active local branch (name*) yellow
#     (\e[33m). Mirrors sapling's [color] defaults sl.remote=green, sl.active=yellow
#     (builtin_static/production.rs)
#   - Local branch names from -b: cyan (\e[36m) — deliberately NOT sapling's
#     sl.book green, so local branches stand apart from green remote refs
#   - PR tags from -p: open blue (\e[34m) — deliberately NOT GitHub's open
#     green, so tags stand apart from green remote refs (and read as links);
#     draft dim blue (\e[2;34m), merged magenta (\e[35m), closed red (\e[31m).
#     Each tag is also an OSC 8 hyperlink to its PR when the palette is on
#   - Uncommitted body: a change marker prefixes each filename; marker and name
#     are colored by kind — A added green (\e[32m), ? untracked dim green (\e[2;32m),
#     D deleted red (\e[31m), R/C renamed blue (\e[34m), T typechange magenta
#     (\e[35m), S submodule cyan (\e[36m), U unmerged bold red (\e[1;31m); M modified
#     and the rest default. A +x/-x hint (dim) flags executable-bit flips. git's own
#     +/- stat graph (green/red) after the '|' is left intact. A submodule's
#     expanded commit sub-lines (›/‹) and every "… +N more" tail are dim (\e[2m);
#     its expanded uncommitted sub-lines are stat lines in their own right, so
#     they keep these very colors, one level in
#   - Symbols (@/o) and lines (│ ╭─╯): default
#
# Paging
#   When stdout is a TTY and the rendered output is taller than the terminal,
#   it is piped through a pager — $GIT_PAGER, then `git config core.pager`,
#   then $PAGER, then `less` (with LESS=FRX exported when $LESS is unset, like
#   git). Output that fits on screen, or piped/redirected output, prints
#   directly; GIT_PAGER=cat disables paging outright. Colors survive paging:
#   the TTY is probed once up front (TTY_OUT), before the wrapper's capture
#   pipe hides it from the renderer.
#   Infinite scroll (opt-in via -f/--full): the public column does not stop at
#   the base — older first-parent history streams below it, row by row, as the
#   consumer takes it. Paged, pipe backpressure keeps `git log` from walking
#   ahead of the pager, so scrolling keeps revealing commits like plain `git
#   log`, down to the root commit; piped, the full history streams out, also
#   like `git log`. Without -f the base row and the trailing "~" are
#   unconditional, paged or not. -f is the one "don't abbreviate" switch, so it
#   also un-compacts other authors' public headers and lifts the 10-line cap on
#   a submodule entry's sub-lines (SUBLINE_CAP), all the way down through a
#   nested submodule.
#   What -f deliberately does NOT undo is -b's ╷ elision. This tail streams
#   lazily and only downward, so its cost is paid one row at a time as you
#   scroll; filling the gaps BETWEEN fork points is eager and unbounded — a
#   branch forking 200 commits down the trunk would push every other tree off
#   screen before you saw it. The ╷ exists to keep distant fork points
#   adjacent, which is the whole point of the -b view.
#
# Relative time — mirrors sapling's `smartdate(date, 5400, age, simpledate)`:
#   - Elapsed <= 5400s (90 min): `age()` — walks scales year→second and uses the
#     smallest where n>=2 (or seconds always); "1" is singularized.
#     Boundaries: <120s → "N seconds ago"; <7200s → "N minutes ago" (n=2..119);
#     etc. Smartlog only ever reaches the seconds/minutes tiers due to threshold.
#   - Elapsed > 5400s (or future): `simpledate()` — uses CALENDAR-day diff
#     (not elapsed seconds) to pick "Today" / "Yesterday" / "<Weekday>" /
#     "<Mon> DD" / full date with HH:MM.
# Source (paths in facebook/sapling): eden/scm/sapling/ext/smartlog.py (simpledate),
#         eden/scm/sapling/templatefilters.py (age),
#         eden/scm/lib/config/loader/src/builtin_static/production.rs (sl_date_threshold).
#
# Iteration
#   ./test/test-readme-examples.zsh replays every example in README.md against a
#   freshly built fixture repo and diffs it against what this script prints now;
#   --update re-captures them. That, not a comparison against sapling, is what
#   says the renderer still works — the views have diverged far enough that a
#   diff against `sl` is noise. See CLAUDE.md.
#   To read raw ANSI back from a TTY-only run: script -q /dev/null <cmd> | cat -v

zmodload zsh/datetime  # provides $EPOCHSECONDS and builtin strftime (no fork)
# Only the zstat builtin (-p cache freshness) — a full zsh/stat load would
# shadow the external `stat` command.
zmodload -F zsh/stat b:zstat

PROG=${0:t}

# Whether stdout is a terminal, probed ONCE before anything runs: run_paged
# captures main's output via $(...), which makes stdout a pipe, so color and
# stat-width decisions inside the renderer must consult this global instead of
# testing [[ -t 1 ]] themselves.
typeset -g TTY_OUT=0
[[ -t 1 ]] && TTY_OUT=1

# Non-ASCII paths: with core.quotePath on (git's default) every path-emitting
# porcelain command (status --porcelain, ls-files, diff --stat/--raw) C-quotes
# them into octal escapes ('"\350\275\256..."'). That's not just unreadable — the
# quoted strings aren't real paths, so ls-files output fails the `*/` dir test
# and `git add -N` (which needs actual paths), silently dropping non-ASCII
# untracked entries from the stat block. Turn it off for every git call at once
# via git's environment-config mechanism (same precedence as `-c`), appending
# after any config the caller already passed this way.
() {
    local n=${GIT_CONFIG_COUNT:-0}
    export GIT_CONFIG_KEY_$n=core.quotepath
    export GIT_CONFIG_VALUE_$n=false
    export GIT_CONFIG_COUNT=$(( n + 1 ))
}

function die {
    # Print an error message to stderr and exit.
    print -ru2 -- "$PROG: $1"
    exit 1
}

function cd_dash_C {
    # Apply the -C <path> occurrences in $@ (zparseopts' flag/value pairs), in
    # order and each relative to the last — git's own -C semantics: run as if
    # git-smartlog had been started in that directory.
    local -i ci=
    for ((ci = 2; ci <= $#; ci += 2)); do
        cd -q -- ${@[ci]} 2>/dev/null || die "cannot change to '${@[ci]}'"
    done
}

function cd_toplevel {
    # Work from the repository root. Every path this script hands git is
    # ROOT-relative, because that is what `git diff` prints — but git resolves a
    # relative GIT_INDEX_FILE against the top level, not the cwd, so from a
    # subdirectory `--git-path index`'s "../../.git/index" pointed outside the
    # repo: an empty index, and every tracked file rendered as deleted. `git
    # ls-files` compounds it by scoping to the cwd, silently dropping untracked
    # files elsewhere in the tree, and a submodule pathspec has the same
    # mismatch. Moving to the top level fixes the class of them at once; nothing
    # here takes a path argument, so the cwd carries no other meaning. Outside a
    # worktree (bare repo) there is nothing to move to — leave it be and let the
    # callers fail with their own messages.
    local top=
    top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    [[ -n $top ]] && cd -q -- "$top"
    return 0
}

function smartlog_usage {
    print -r -- "usage: $PROG [-C <path>] [-c] [-b] [-f] [-p|-P] [--base REV]

Sapling-inspired smartlog using only git: the current branch's draft stack
drawn on top of its nearest public (pushed) base. A dirty working tree always
draws an \"Uncommitted changes\" node on top of HEAD, carrying its totals.

The three view flags below are independent and combine freely.

  -c, --changes       show per-file changes under every commit in the current
                      stack — or under the public commit in view when HEAD
                      sits on the trunk (pair with -f for history) — and under
                      the uncommitted node, which otherwise shows totals only
  -b, --branches      show every other local branch as its full stack —
                      including forks at draft commits and commits stacked
                      above HEAD
  -f, --full          don't abbreviate: show author + subject on every commit
                      (including other authors' public ones, which otherwise
                      render metadata-only), keep streaming older
                      public history below the base — lazily when paged, like
                      git log — and stop capping a submodule entry's sub-lines
                      at 10 (-b's ╷ elision stays — it keeps distant fork
                      points adjacent, which is the point of that view)
  -p, --prs           tag shown branch names that have a GitHub PR with its
                      \"#N\" — colored by PR state, hyperlinked on a TTY
                      (needs the gh CLI); sticky — remembered per repo, so
                      later runs tag PRs without the flag
  -P, --no-prs        turn PR tagging off and forget the remembered -p
                      (wins when both are given)
      --base REV      override the public base (default: nearest remote trunk, e.g.
                      origin/HEAD, origin/main, origin/master, upstream/main) —
                      needed for any other trunk, e.g. develop or release/2.x.
                      Everything at or below REV then renders public (◆),
                      whether or not it has been pushed
  -C <path>           run as if started in <path>, like git's own -C; repeats
                      compose, each relative to the last
  -h, --help          show this help and exit

Output taller than the terminal is paged (\$GIT_PAGER / core.pager / \$PAGER /
less; GIT_PAGER=cat disables paging)."
}

function smartstat_usage {
    print -r -- "usage: $PROG [-C <path>] [--color WHEN]

Show uncommitted working-tree changes as a compact stat block: a summary line
(\"2 files, +69 -2\") followed by per-file diff bars; loose untracked files are
folded in and wholly-untracked directories collapse to a single entry like git
status. Each name carries a change marker — A added, ? untracked, M modified,
D deleted, R renamed, T typechange, S submodule, U unmerged — colored by kind.
Prints nothing when the working tree is clean. The same block git-smartlog draws
under its uncommitted-changes node with -c.

      --color WHEN    colorize output: auto (default), always, or never
  -C <path>           run as if started in <path>, like git's own -C
  -h, --help          show this help and exit"
}

function resolve_base {
    local arg=$1
    if [[ -n $arg ]]; then
        git rev-parse --verify "$arg" >/dev/null 2>&1 || return 1
        print -r -- "$arg"
        return 0
    fi
    # Candidate trunks are REMOTE-tracking refs only: "public" commits come from
    # what's been pushed, never from a local branch. A local main/master — or the
    # branch you're on — can sit at or ahead of HEAD, which would make its
    # merge-base with HEAD == HEAD and collapse the whole draft stack.
    # <remote>/HEAD resolves to e.g. origin/master, so normalize via --abbrev-ref.
    local -a candidates
    local ref
    for ref in origin/HEAD upstream/HEAD \
               origin/main origin/master upstream/main upstream/master; do
        git rev-parse --verify "$ref" >/dev/null 2>&1 || continue
        candidates+=("$(git rev-parse --abbrev-ref "$ref")")
    done
    candidates=(${(u)candidates})

    # Among candidates, pick the one whose merge-base with HEAD is closest to HEAD
    # (i.e. the most recent common ancestor) — the nearest public ancestor. This
    # tolerates a stale fork remote (e.g. origin/master behind upstream/main).
    local best= best_mb= mb
    for ref in $candidates; do
        mb=$(git merge-base HEAD "$ref" 2>/dev/null) || continue
        if [[ -z $best ]] || git merge-base --is-ancestor "$best_mb" "$mb"; then
            best=$ref
            best_mb=$mb
        fi
    done
    if [[ -n $best ]]; then
        print -r -- "$best"
        return 0
    fi

    # Fallbacks for a repo with no remote trunk (local-only, or non-standard
    # setup): the current branch's upstream, then a local main/master.
    local upstream
    if upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
        print -r -- "$upstream"
        return 0
    fi
    for ref in main master; do
        if git rev-parse --verify "$ref" >/dev/null 2>&1; then
            print -r -- "$ref"
            return 0
        fi
    done
    return 1
}

# Globals set once in main() to avoid per-commit recomputation.
typeset -g NOW TODAY_MIDNIGHT CURRENT_YEAR ACTIVE_BRANCH

# uncommitted_stat()'s outputs (REPLY-style globals, read by both entry points).
typeset -g STAT_HAS_CHANGES STAT_SUMMARY
typeset -ga STAT_BODY

# Lines a submodule entry may expand to per group before the rest fold into a
# "… +N more" tail; 0 lifts the cap entirely, which -f/--full does. Read by
# submodule_sublines, and inherited by the nested run a dirty submodule inside a
# submodule triggers, so -f uncaps all the way down.
typeset -g SUBLINE_CAP=10

# Row cap for -f's streamed-history tail, 0 = unlimited. Stays 0 on the paged
# path, where pipe backpressure already bounds the walk; the TUI sets it
# because it captures a render whole, and an uncapped -f capture would walk
# first-parent history to the root commit before the first frame draws.
typeset -gi TAIL_CAP=0

# Interactive-mode state (see smartlog_tui). TUI_ACTIVE guards tui_restore so
# the teardown is idempotent across its several triggers (q, EXIT trap,
# signal traps); TUI_ERRF is the stderr capture file tui_restore must clean
# up on any exit.
typeset -gi TUI_ACTIVE=0
typeset -g TUI_ERRF=

# Whether uncommitted_stat should build STAT_BODY at all. main clears it for the
# wdir node when -c is absent — the header's summary is all that renders then,
# and everything past it (markers, colors, sorting, and the per-submodule forks
# that expand an S entry) is work nobody reads.
typeset -g STAT_WANT_BODY=1

# How many hash digits a header row shows. Purely a readability width: the
# digits that actually matter are the shortest UNIQUE prefix, which abbrev_hash
# measures and commit_header dims the rest of. A repo big enough to collide
# within this width is shown the wider unique prefix instead, never an ambiguous
# hash.
typeset -gi HASH_WIDTH=10

# abbrev_hash()'s second output, alongside REPLY.
typeset -gi REPLY_UNIQ=0

# filter_refs' second output: the branch names behind the refs it kept — the
# active branch's name (even when its display is folded into the same-name
# remote) and each remote bookmark stripped of its remote — i.e. the -p/--prs
# lookup keys for the row being rendered.
typeset -ga REF_BRANCHES

# Helpers set REPLY instead of printing — avoids a $(...) subshell per call.

function abbrev_hash {
    # $1 the full sha, $2 git's shortest unique abbreviation of it (%h fetched
    # under --abbrev=4 — git widens past that floor until the prefix names
    # exactly one object, so it comes free with the metadata that row already
    # needs). REPLY = the hash to display: HASH_WIDTH digits, or the unique
    # prefix itself when that is longer, since a repo that collides within
    # HASH_WIDTH would otherwise be handed an ambiguous hash — git widens its
    # own output for the same reason. REPLY_UNIQ = how many of those digits are
    # the unique prefix, so commit_header can dim the rest: borrowed from jj,
    # whose ids show at a glance how much of the hash you actually need to type.
    # Not named `full` — that's main's -f/--full flag, and every helper here
    # reads main's locals by dynamic scoping.
    local sha=$1 uniq=$2
    REPLY_UNIQ=${#uniq}
    if (( REPLY_UNIQ < HASH_WIDTH )); then
        REPLY=${sha[1,HASH_WIDTH]}
    else
        REPLY=$uniq
    fi
}

function draft_node {
    # REPLY = the node glyph for draft $1: ◇ once the commit is on a remote, o
    # while it's still only yours. Third step of the ramp is ◆ (public), so the
    # shape alone reads o → ◇ → ◆, increasingly set in stone. Deliberately NOT
    # carried by the hash color: under this script's own palette (and Dracula,
    # and most 16-color themes) \e[33m and \e[93m are the same yellow to the
    # eye, so a color-only mark would have been invisible — bold was doing all
    # the work. Reads main's pushed map via dynamic scoping.
    if [[ -n ${pushed[$1]:-} ]]; then
        REPLY=◇
    else
        REPLY=o
    fi
}

function empty_tag {
    # REPLY = a dim "(empty) " prefix for commit $1's subject when the commit
    # changed nothing against its first parent, "" otherwise. Borrowed from jj,
    # which labels these in its log. They're worth a word: a commit whose
    # changes landed upstream some other way comes back from a rebase emptied,
    # and is otherwise indistinguishable from one still carrying work. Unlike
    # the dimmed hash tail this has to survive NO_COLOR, so it's text, not
    # color. Reads main's is_empty map via dynamic scoping.
    if [[ -n ${is_empty[$1]:-} ]]; then
        REPLY="${C_DIM}(empty)${C_RESET} "
    else
        REPLY=
    fi
}

function age {
    # Mirrors sapling's `age` templatefilter: walks scales year→second, uses the
    # smallest where n>=2 (or seconds as fallback). Singularizes when n==1.
    local delta=$1
    (( delta < 1 )) && delta=1
    local scales=(31536000 2592000 604800 86400 3600 60 1)
    local names=(year month week day hour minute second)
    local i n unit
    for i in {1..7}; do
        n=$((delta / scales[i]))
        if (( n >= 2 || scales[i] == 1 )); then
            unit=${names[i]}
            (( n != 1 )) && unit="${unit}s"
            REPLY="${n} ${unit} ago"
            return
        fi
    done
}

function simpledate {
    # Mirrors sapling's `simpledate` templatefunc. Uses calendar-day diff, not
    # elapsed seconds, so 23:50 yesterday is "Yesterday" even when 20 min ago.
    local epoch=$1
    local hm
    strftime -s hm '%H:%M' $epoch

    if (( epoch > NOW )); then
        strftime -s REPLY '%Y-%m-%d %H:%M' $epoch
        return
    fi

    local commit_date commit_midnight td_days
    strftime -s commit_date '%Y-%m-%d' $epoch
    strftime -rs commit_midnight '%Y-%m-%d %H:%M:%S' "$commit_date 00:00:00"
    td_days=$(( (TODAY_MIDNIGHT - commit_midnight) / 86400 ))

    if (( td_days == 0 )); then
        REPLY="Today at ${hm}"
    elif (( td_days == 1 )); then
        REPLY="Yesterday at ${hm}"
    elif (( td_days <= 6 )); then
        local weekday
        strftime -s weekday '%A' $epoch
        REPLY="${weekday} at ${hm}"
    else
        local commit_year
        strftime -s commit_year '%Y' $epoch
        if [[ $commit_year == $CURRENT_YEAR ]] || (( td_days <= 90 )); then
            local md
            strftime -s md '%b %d' $epoch
            REPLY="${md} at ${hm}"
        else
            strftime -s REPLY '%Y-%m-%d %H:%M' $epoch
        fi
    fi
}

function reltime {
    # Mirrors sapling's smartlog template: smartdate(date, 5400, age, simpledate).
    local epoch=$1
    local diff=$((NOW - epoch))
    if (( diff >= 0 && diff <= 5400 )); then
        age $diff
    else
        simpledate $epoch
    fi
}

function filter_refs {
    # Operates on %D from `git log --decorate=full`, so every ref is a full path:
    #   "HEAD -> refs/heads/feat, refs/remotes/origin/feat, refs/tags/v1, ..."
    # Follows sapling's rule: remote bookmarks (refs/remotes/*) plus the active
    # local branch as $ACTIVE_BRANCH ("name*"), precomputed in main(). Inactive
    # local branches and tags are hidden, as is the active branch when a remote of
    # the same name exists (sapling shows only the remote bookmark — e.g. `master`
    # yields just `origin/master`, never `master*`). sapling sorts names, so sort
    # alphabetically; join with a single space.
    local raw=$1
    REPLY=
    REF_BRANCHES=()
    [[ -z $raw ]] && return
    local -a out
    local r
    for r in ${(@s:, :)raw}; do
        case $r in
            "HEAD -> "*)                                    # active branch (HEAD's)
                [[ -n $ACTIVE_BRANCH ]] && out+=("$ACTIVE_BRANCH")
                # PR lookup key even when the name display folds into the
                # same-name remote (ACTIVE_BRANCH empty).
                REF_BRANCHES+=("${r#HEAD -> refs/heads/}") ;;
            HEAD) ;;                                        # detached-HEAD self-ref
            */HEAD) ;;                                      # remote default-branch pointer
            refs/heads/*) ;;                                # inactive local branch — hidden
            refs/tags/*|"tag: "*) ;;                        # tag — smartlog doesn't show tags
                                                            # (%D emits "tag: refs/tags/v1")
            refs/remotes/*)                                 # remote bookmark → origin/master
                out+=("${r#refs/remotes/}")
                REF_BRANCHES+=("${${r#refs/remotes/}#*/}") ;;
            *) out+=("$r") ;;
        esac
    done
    out=(${(o)out})
    REPLY="${(j: :)out}"
}

function submodule_sublines {
    # reply = the sub-lines that detail a submodule entry, drawn under its S
    # line: first the submodule's own UNCOMMITTED changes, then the commits its
    # pointer gained or lost. Each group renders at most SUBLINE_CAP lines,
    # then a dim "… +N more" tail; the cap is lifted (0) under -N.
    #
    # Uncommitted group (working-tree mode only — a committed diff has no
    # working tree). The parent's gitlink diff can't reach inside a submodule:
    # one that is merely dirty has an unchanged sha, so its stat line is a bare
    # "| 0" saying nothing at all. So recompute this file's own stat block with
    # the submodule as cwd and indent its body under the S line — same markers,
    # colors and bars, one level in (a dirty submodule of a dirty submodule
    # keeps nesting). It runs in a $(...) subshell so the cd is contained and
    # the caller's STAT_* globals — which it is in the middle of rendering —
    # stay untouched; uncommitted_stat's own die() then merely empties the
    # capture, degrading to no sub-lines.
    #
    # Commit group: the `git diff --submodule=log` subjects, newest first. Git
    # prints "  > subject" for a commit gained and "  < " for one lost (a
    # rewind); everything else in its output (the "Submodule path a..b:"
    # header, "(commits not present)" notes, and the "contains modified
    # content" note the uncommitted group above covers) is skipped, so an
    # unsummarizable bump yields nothing and a clean-worktree bump's bare S line
    # stands alone.
    #
    # $1 leading spaces (to align under the S line), $2 color_on, $3 the columns
    # the caller reserves ahead of each body line, $4 the commit being stat'd
    # (empty in working-tree mode), $5 submodule path, $6.. the diff endpoints
    # `git diff` ran against ($parent $commit, or the working-tree target) — so
    # both -c (commit) and the wdir node (worktree) work.
    local lead=$1 color_on=$2 reserve=$3 commit=$4 sub=$5; shift 5
    reply=()
    local dim= reset=
    (( color_on )) && { dim=$'\e[2m'; reset=$'\e[0m'; }
    local -i cap=${SUBLINE_CAP:-10} n=0 i=0 shown=0

    local -a dirty=()
    if [[ -z $commit ]]; then
        # $sub is repo-root-relative (that is what `git diff` prints) and the
        # cwd IS the root — cd_toplevel saw to that — so it resolves as-is. An
        # UNINITIALIZED submodule is an empty directory inside the parent's own
        # worktree, where git would happily report the parent's changes as the
        # submodule's — require the submodule's own .git (gitfile or dir) first.
        if [[ -e $sub/.git ]]; then
            dirty=("${(@f)$(cd -q -- $sub &&
                uncommitted_stat $color_on $(( reserve + ${#lead} + 3 )) &&
                (( STAT_HAS_CHANGES )) && print -rl -- "${STAT_BODY[@]}")}")
            dirty=(${dirty:#})
        fi
    fi

    local -a subjects=()
    local ln= dir=
    for ln in ${(f)"$(git diff --submodule=log "$@" -- "$sub" 2>/dev/null)"}; do
        case $ln in
            '  > '*) dir='›' ;;
            '  < '*) dir='‹' ;;
            *) continue ;;
        esac
        subjects+=("${dim}${dir} ${ln[5,-1]}${reset}")   # drop the "  > " / "  < " prefix
    done

    # A --stat line carries its own leading space, so indent it one column less
    # than the commit lines to land every marker (and every ›/‹) in one column.
    n=${#dirty}
    shown=$n
    (( cap > 0 && cap < n )) && shown=$cap
    for ((i = 1; i <= shown; i++)); do
        reply+=("${lead}   ${dirty[i]}")
    done
    (( shown < n )) && reply+=("${lead}    ${dim}… +$(( n - shown )) more${reset}")

    n=${#subjects}
    shown=$n
    (( cap > 0 && cap < n )) && shown=$cap
    for ((i = 1; i <= shown; i++)); do
        reply+=("${lead}    ${subjects[i]}")
    done
    (( shown < n )) && reply+=("${lead}    ${dim}… +$(( n - shown )) more${reset}")
}

function uncommitted_stat {
    # Compute the uncommitted-changes stat block. $1 = color_on (1 to colorize the
    # marker/name and request colored +/- bars from git; 0 for plain). Sets globals
    # STAT_HAS_CHANGES (0/1), STAT_SUMMARY (a plain "N files, +X -Y" string — never
    # colored, the caller styles it) and STAT_BODY (per-file body lines, marked and,
    # when color_on, colored). Reads the working tree only; never mutates the real
    # index. Shared by git-smartlog's wdir node and standalone `git-smartstat`.
    # STAT_WANT_BODY=0 asks for the summary alone and leaves STAT_BODY empty.
    #
    # $3 (optional) = a commit: stat THAT commit's changes — against its first
    # parent, or the empty tree for a root commit — instead of the working tree
    # (used by -c). The working-tree machinery below (porcelain, untracked
    # folding, the index overlay, unmerged detection) all no-ops in this mode;
    # body format, markers, colors and sorting are identical.
    local color_on=$1
    local reserve=${2:-0}   # columns the caller will prepend to each body line
    local commit=${3:-}
    local parent=${4:-}     # $3's first parent, when the caller already knows it
    STAT_HAS_CHANGES=0
    STAT_SUMMARY=
    STAT_BODY=()

    # Width for the `git diff --stat` body. It's captured via $(...) below, so git
    # sees a pipe and would pin to its 80-column non-TTY default — truncating long
    # paths to "...tail" no matter how wide the real terminal is. When OUR stdout is
    # a terminal, probe its width and pass it through, so paths show in full when
    # there's room; git still truncates to fit a narrow terminal. Piped output stays
    # at 80, keeping captures stable. The width comes from the controlling terminal
    # (`stty size </dev/tty`) — not `<&1`, which inside $(...) is the capture pipe,
    # not the tty — with $COLUMNS as a fallback.
    local stat_width=80
    if (( TTY_OUT )); then
        local termsize=
        termsize=$(stty size </dev/tty 2>/dev/null)   # "rows cols"
        if [[ $termsize == <->" "<-> ]]; then
            stat_width=${termsize##* }
        elif [[ -n $COLUMNS ]] && (( COLUMNS >= 20 )); then
            stat_width=$COLUMNS
        fi
        # Shrink the width git is told to use so the assembled line fits the real
        # terminal: reserve the caller's per-line prefix (the wdir node indents the
        # body by "  │ ") plus the 2-column change marker ("? ") this function adds
        # to every git --stat line. Piped output has no terminal to overflow, so it
        # keeps 80.
        (( stat_width -= reserve + 2 ))
        (( stat_width < 20 )) && stat_width=20
    fi

    # The two diff endpoints the `git diff` below runs against: "<base>" (the
    # working tree being the implicit right side) in working-tree mode, or
    # "<parent> <commit>" in commit mode.
    local -a diff_args
    local porcelain=
    if [[ -n $commit ]]; then
        # Commit mode: diff against the first parent, or git's empty-tree object
        # for a root commit. The caller passes the parent when it already has it
        # ($4) — main and stream_public_tail both carry %P from their `git log`,
        # and -c stats one commit per row, so looking it up here would be a fork
        # per row. Emptiness is decided by the diff itself further down.
        [[ -n $parent ]] ||
            parent=$(git rev-parse --verify --quiet "${commit}^" 2>/dev/null)
        [[ -n $parent ]] || parent=4b825dc642cb6eb9a060e54bf8d69288fbee4904
        diff_args=("$parent" "$commit")
    else
        porcelain=$(git status --porcelain 2>/dev/null)
        [[ -z $porcelain ]] && return
        # Diff against HEAD, or git's empty-tree object when HEAD is unborn (a repo
        # with no commits) so staged/untracked files still show as additions.
        local diff_target=HEAD
        git rev-parse --verify --quiet HEAD >/dev/null 2>&1 ||
            diff_target=4b825dc642cb6eb9a060e54bf8d69288fbee4904
        diff_args=("$diff_target")
        STAT_HAS_CHANGES=1
    fi

    # Untracked entries via `git ls-files --directory`: a wholly-untracked directory
    # folds to ONE 'dir/' entry (mirroring `git status`), while loose untracked files
    # (under a dir that also holds tracked paths) appear individually. Unlike `git
    # status --porcelain`, ls-files does not C-quote paths that merely contain spaces,
    # so spaced names survive intact (non-ASCII too — quotePath is off globally, above).
    # Only loose files are intent-added to the overlay below, so each untracked dir
    # renders as a single "dir/ | N files" line instead of expanding to every file.
    # Commit mode has no untracked entries by definition — skip the scan.
    local -a untracked_files=() untracked_dirs=()
    local ue=
    [[ -z $commit ]] && for ue in ${(f)"$(git ls-files --others --exclude-standard --directory --no-empty-directory 2>/dev/null)"}; do
        if [[ $ue == */ ]]; then untracked_dirs+=("$ue"); else untracked_files+=("$ue"); fi
    done

    # The index only matters in working-tree mode, where the untracked overlay
    # below replaces it; a commit-mode diff reads neither side from it. Skipping
    # the lookup there drops another fork per -c row.
    local stat_index=
    [[ -n $commit ]] || stat_index=$(git rev-parse --git-path index 2>/dev/null)
    local tmp_index=
    {
        # `git diff` only sees tracked paths, so loose untracked files would be
        # missing from the +/- totals and the body. Fold them in WITHOUT mutating
        # the repo: copy the index to a throwaway file and `git add -N` (intent-to-
        # add) the loose paths there; against that temp index `git diff` renders each
        # as a new file with its lines as additions, aligned with the tracked
        # entries. GIT_INDEX_FILE keeps the real index and working tree untouched.
        # With no loose untracked files, stat_index points at the real index — a
        # no-op. The temp index is removed via `always`, even on an early error.
        if (( ${#untracked_files} )); then
            tmp_index=$(mktemp) || die "cannot create temp index"
            [[ -f $stat_index ]] && cp "$stat_index" "$tmp_index"
            GIT_INDEX_FILE=$tmp_index git add -N -- "${untracked_files[@]}" 2>/dev/null
            stat_index=$tmp_index
        fi

        # ONE `git diff` for everything this function needs, not four of the same
        # pair: --raw and --stat together emit the raw records first (each
        # starting with ':', classified into markers further down), then the
        # per-file bars, then git's own "N files changed, X insertions(+), Y
        # deletions(-)" line — which is exactly what a separate --shortstat
        # would return, and what --quiet would have probed for (no output at all
        # means no changes). -c stats one commit per row, so each fork saved here
        # is saved per row.
        #
        # Width is forced to stat_width (terminal width, or 80 when piped — see
        # above) since the $(...) capture hides the real terminal from git. The
        # capture also strips git's color, so force it back on when color_on; the
        # raw records and the summary line come out plain either way.
        local stat_color=--color=never
        (( color_on )) && stat_color=--color=always
        local -a diff_out=()
        if [[ -n $stat_index ]]; then
            diff_out=("${(@f)$(GIT_INDEX_FILE=$stat_index git diff --raw $stat_color --stat=$stat_width $diff_args 2>/dev/null)}")
        else
            diff_out=("${(@f)$(git diff --raw $stat_color --stat=$stat_width $diff_args 2>/dev/null)}")
        fi
        local -a raw_lines=()
        local dl=
        STAT_BODY=()
        for dl in $diff_out; do
            if [[ $dl == :* ]]; then raw_lines+=("$dl"); else STAT_BODY+=("$dl"); fi
        done
        # Commit mode defers its emptiness check to here: an empty commit has no
        # diff at all, and contributes no body. (Working-tree mode already
        # committed to HAS_CHANGES from porcelain — an untracked directory alone
        # produces no diff yet still renders a body line.)
        if [[ -n $commit ]]; then
            # Content, not count: ${(@f)} of empty output still yields one
            # (empty) field, so a length test never fires and an empty commit
            # used to fall through to a bare "0 files" body line.
            [[ -n ${diff_out[1]} ]] || return
            STAT_HAS_CHANGES=1
        fi

        # Compact totals for the summary line, off that trailing line. File count
        # and +/- line totals cover the overlay diff (tracked changes + loose
        # untracked files); each collapsed untracked directory is then counted as
        # one more "file" (its contents aren't diffed, so it adds nothing to the
        # +/- line totals — its body line shows a file count instead). The summary
        # still matches the body: one counted entry per body line.
        local summary= n_files=0 ins=0 del=0
        if (( ${#STAT_BODY} )); then
            summary=${STAT_BODY[-1]}
            STAT_BODY=("${(@)STAT_BODY[1,-2]}")
        fi
        [[ $summary =~ '([0-9]+) files? changed' ]] && n_files=$match[1]
        [[ $summary =~ '([0-9]+) insertion' ]] && ins=$match[1]
        [[ $summary =~ '([0-9]+) deletion' ]] && del=$match[1]
        (( n_files += ${#untracked_dirs} ))
        local file_word=files
        (( n_files == 1 )) && file_word=file
        STAT_SUMMARY="${n_files} ${file_word}"
        (( ins > 0 || del > 0 )) && STAT_SUMMARY+=", +${ins} -${del}"

        # Summary-only caller (the wdir node without -c): stop here. Everything
        # below only shapes STAT_BODY, and the temp index still goes away — the
        # `always` block runs on return.
        if (( ! STAT_WANT_BODY )); then
            STAT_BODY=()
            return
        fi

        # Marker/color maps per body filename. Declared up here (not inside the
        # classification block) so the synthetic untracked-dir lines appended next
        # can register their '?' marker even when there are no tracked/loose lines.
        # wdir_sortkey overrides the within-group sort key for an entry whose display
        # name is truncated — collapsed dirs key on their FULL path so they sort in
        # `git status` order, not clustered by their leading "...".
        local -A wdir_mark wdir_col wdir_hint wdir_sortkey
        # Shared name-column width for the body. 0 means "leave git's own alignment"
        # (no untracked dirs); when dirs exist it's set below and re-pads git lines in
        # the render pass so every '|' stays aligned.
        local name_w=0

        # One synthetic stat line per collapsed untracked dir: "dir/ | N files".
        # git sizes its name column to the tracked/loose names only, so a longer dir
        # name would have to truncate to fit it. Instead, grow the shared column to
        # the longest entry (file OR dir) and re-pad the git lines, so dirs show in
        # full when the terminal has room. The growth is capped so the longest line
        # still fits stat_width; names past the cap truncate head-first ("...tail").
        # Each dir registers a '?' marker, so it groups/sorts with the loose untracked
        # files (dim green, '?' rank) in the render pass below.
        if (( ${#untracked_dirs} )); then
            # gitcol = git's current '|' column (shared by every git line); maxafter =
            # widest graph (ANSI stripped), so the column can grow only as far as keeps
            # the longest line within stat_width.
            # All widths here are DISPLAY cells, not characters — zsh's (m) flag —
            # so CJK/wide names (2 cells per char) keep the '|' column aligned.
            local gitcol=0 maxafter=0 count_w=0 bl= bcol= aft= d=
            for bl in $STAT_BODY; do
                [[ $bl == *\|* ]] || continue
                bcol=${bl%%\|*}; (( ${(m)#bcol} > gitcol )) && gitcol=${(m)#bcol}
                aft=${(S)${bl#"$bcol"}//$'\e['*m/}   # "| graph" incl '|', ANSI stripped
                (( ${#aft} > maxafter )) && maxafter=${#aft}
                # git right-justifies each per-file line count to a shared width (the
                # widest count's digits). Capture that width so the collapsed-dir
                # "N files" counts can right-justify into the same column. The leading
                # token after '|' is the count; Bin/0/graph chars don't match [0-9]+
                # at that position, so only real line counts set it.
                [[ $aft =~ '^\|[[:space:]]*([0-9]+)' ]] &&
                    (( ${#match[1]} > count_w )) && count_w=${#match[1]}
            done
            local avail=0
            for d in $untracked_dirs; do (( ${(m)#d} > avail )) && avail=${(m)#d}; done
            (( gitcol > 2 && gitcol - 2 > avail )) && avail=$(( gitcol - 2 ))
            # Cap so " name | <graph or 'N files'>" still fits stat_width.
            local suffixmax=$maxafter
            (( suffixmax < 12 )) && suffixmax=12
            local cap=$(( stat_width - 4 - suffixmax ))
            (( cap < 20 )) && cap=20
            (( avail > cap )) && avail=cap
            (( avail < 4 )) && avail=4
            name_w=$avail
            # File counts come from the full recursive untracked list.
            local -a all_untracked=(${(f)"$(git ls-files --others --exclude-standard 2>/dev/null)"})
            # Pass 1: compute each dir's display name and file count, tracking the
            # widest count. When there are NO git --stat lines (count_w==0), the dirs
            # have nothing to align to, so fall back to that widest dir count and
            # right-justify them among themselves. When git lines DO exist, count_w
            # already holds git's column width and we align dir counts to it (a dir
            # with more files than git's widest line count is the only case that can
            # still overhang — git's numbers are already printed, so they can't grow).
            local -a dir_disp=() dir_n=() dir_path=()
            local disp= n= f= max_dir_w=0
            for d in $untracked_dirs; do
                disp=$d
                if (( ${(m)#disp} > avail )); then
                    # Trim leading chars until the "...tail" fits avail cells; a wide
                    # char can drop 2 cells per trim, so test width, not char count.
                    while (( ${(m)#disp} > avail - 3 )); do disp=${disp[2,-1]}; done
                    disp="...$disp"
                fi
                n=0
                for f in $all_untracked; do [[ ${f[1,${#d}]} == "$d" ]] && (( n++ )); done
                dir_disp+=("$disp"); dir_n+=("$n"); dir_path+=("$d")
                (( ${#n} > max_dir_w )) && max_dir_w=${#n}
            done
            (( count_w == 0 )) && count_w=$max_dir_w
            # Pass 2: emit one "dir/ | N files" line per dir, the count right-justified
            # to count_w so it lines up with git's per-file line-count column.
            local word= nsp= pad= di=
            for ((di = 1; di <= ${#dir_disp}; di++)); do
                disp=${dir_disp[di]}; n=${dir_n[di]}
                word=files; (( n == 1 )) && word=file
                nsp=$(( avail - ${(m)#disp} )); pad=
                (( nsp > 0 )) && pad=${(l:$nsp:)pad}
                STAT_BODY+=(" ${disp}${pad} | ${(l:$count_w:)n} ${word}")
                wdir_mark[$disp]='?'
                wdir_col[$disp]=$'\e[2;32m'
                wdir_hint[$disp]=
                wdir_sortkey[$disp]=${dir_path[di]}
            done
        fi

        # Prefix each body filename with a one-letter change marker, classified from
        # `git diff --raw` against the same overlay, and color-code both marker and
        # name by kind:
        #   A new (staged)  green       ? untracked    dim green
        #   D deleted       red         R/C renamed    blue
        #   M modified      default     T typechange   magenta
        #   S submodule     cyan        U unmerged     bold red
        # A pure executable-bit flip (chmod) is status M with a "| 0" stat, so it
        # would be invisible — surface it with a trailing "+x"/"-x" hint. The marker
        # is a uniform 2-char prefix on EVERY line, so git's pre-aligned '|' column
        # just shifts right and stays aligned. Markers show in plain output too; only
        # the coloring is gated on color_on. git's own +/- graph after the '|' is
        # untouched. Long paths git truncates to "...tail" are matched by that tail;
        # renames show as "old => new" (no raw path match) so are flagged R via that
        # arrow; an unmatched line falls back to a blank marker (alignment preserved).
        if (( ${#STAT_BODY} )); then
            # Loose untracked paths were intent-to-added into the overlay, so `git
            # diff` reports them as A like a staged-new file; re-split them as ?.
            local -A is_untracked
            local u
            for u in $untracked_files; do is_untracked[$u]=1; done
            # Conflicted paths show as plain M in `git diff --raw`, so take the
            # unmerged set from porcelain status codes (DD/AU/UD/UA/DU/AA/UU) instead.
            local -A is_unmerged
            local pl
            for pl in ${(f)porcelain}; do
                case ${pl[1,2]} in
                    DD|AU|UD|UA|DU|AA|UU) is_unmerged[${pl[4,-1]}]=1 ;;
                esac
            done

            local raw_line
            for raw_line in $raw_lines; do
                local -a mf=(${=${raw_line%%$'\t'*}})   # :oldmode newmode oldsha newsha STATUS
                local p=${raw_line##*$'\t'}             # path (new path for renames)
                local om=${mf[1]#:} nm=${mf[2]} st=${mf[5]} mark= col= hint=
                if [[ $om == 160000 || $nm == 160000 ]]; then
                    mark=S col=$'\e[36m'                  # submodule -> cyan
                else
                    mark=${st:0:1}                        # A/M/D/R/C/T/U...
                    case $mark in
                        A) if [[ -n ${is_untracked[$p]} ]]; then
                               mark='?' col=$'\e[2;32m'   # untracked -> dim green
                           else
                               col=$'\e[32m'              # staged new -> green
                           fi ;;
                        D)   col=$'\e[31m' ;;             # deleted -> red
                        R|C) col=$'\e[34m' ;;             # renamed/copied -> blue
                        T)   col=$'\e[35m' ;;             # typechange (file<->symlink) -> magenta
                        U)   col=$'\e[1;31m' ;;           # unmerged/conflict -> bold red
                    esac
                    # Executable-bit flip that --stat renders as "| 0" (status M).
                    if [[ $mark == M && $om != $nm && $om != 000000 && $nm != 000000 ]]; then
                        [[ $nm == 100755 ]] && hint=' +x'
                        [[ $nm == 100644 && $om == 100755 ]] && hint=' -x'
                    fi
                fi
                # A conflicted path overrides everything else: unmerged -> bold red U.
                [[ -n ${is_unmerged[$p]} ]] && { mark=U; col=$'\e[1;31m'; hint=; }
                wdir_mark[$p]=$mark
                wdir_col[$p]=$col
                wdir_hint[$p]=$hint
            done

            if (( ${#wdir_mark} )); then
                local creset=$'\e[0m'
                # Render each line, tagging it with a signal rank and a full-path sort
                # key; then re-emit the body grouped by rank (A ? M D R T S U, then
                # anything else) so the colors cluster, sorted by path within each group.
                local -a r_line=() r_rank=() r_name=() reply=()
                local sline= before= after= lead= body= trail= nf= mark= col= hint= cp= rank= rendered= tw= sp= skey=
                for sline in $STAT_BODY; do
                    before=${sline%%\|*}            # " name<pad> " up to the first '|'
                    if [[ $before == $sline ]]; then
                        r_line+=("$sline"); r_rank+=(9); r_name+=("$sline"); continue   # no '|': keep, sort last
                    fi
                    after=${sline#"$before"}        # "| graph..." with git's colors
                    lead=${before%%[! ]*}           # leading spaces
                    body=${before#"$lead"}          # name + trailing pad
                    trail=${body##*[! ]}            # trailing spaces
                    nf=${body%"$trail"}             # the display name
                    if (( name_w > 0 )); then        # re-pad to the shared column so a
                        tw=$(( name_w - ${(m)#nf} + 1 ))  # collapsed dir (maybe wider than
                        (( tw < 1 )) && tw=1            # git's own names) and the git
                        trail=${(l:$tw:)sp}            # lines keep one aligned '|'
                    fi
                    # Sort key: the FULL path, so a name git truncated to "...tail" (or
                    # a collapsed dir) still sorts in git's order, not by its "...".
                    skey=${wdir_sortkey[$nf]:-$nf}
                    mark=${wdir_mark[$nf]}
                    col=${wdir_col[$nf]}
                    hint=${wdir_hint[$nf]}
                    if [[ -z $mark ]]; then
                        if [[ $nf == *" => "* ]]; then
                            mark=R col=$'\e[34m'    # rename: stat shows "old => new" -> blue
                        elif [[ $nf == ...* ]]; then
                            for cp in ${(k)wdir_mark}; do   # truncated path: match by tail
                                if [[ $cp == *"${nf#...}" ]]; then
                                    mark=${wdir_mark[$cp]}
                                    col=${wdir_col[$cp]}
                                    hint=${wdir_hint[$cp]}
                                    skey=$cp           # full path for the sort key
                                    break
                                fi
                            done
                        fi
                        [[ -z $mark ]] && mark=' '  # fallback: blank marker, keep alignment
                    fi
                    # Dim the mode hint so it reads as a subordinate annotation.
                    (( color_on )) && [[ -n $hint ]] && hint=$'\e[2m'"${hint}${creset}"
                    if (( color_on )) && [[ -n $col ]]; then
                        rendered="${lead}${col}${mark}${creset} ${col}${nf}${creset}${trail}${after}${hint}"
                    else
                        rendered="${lead}${mark} ${nf}${trail}${after}${hint}"
                    fi
                    case $mark in
                        A)   rank=1 ;;
                        '?') rank=2 ;;
                        M)   rank=3 ;;
                        D)   rank=4 ;;
                        R|C) rank=5 ;;
                        T)   rank=6 ;;
                        S)   rank=7 ;;
                        U)   rank=8 ;;
                        *)   rank=9 ;;
                    esac
                    # A submodule bump (S) carries its (capped) commit list as
                    # extra lines on the SAME entry — newline-joined onto the
                    # rendered S line — so the group sort keeps them attached to
                    # it; the flatten pass below splits them back into their own
                    # STAT_BODY lines. STAT_BODY must stay one-line-per-element
                    # for the wdir node consumer, which prefixes each element with
                    # its own gutter.
                    if [[ $mark == S ]]; then
                        submodule_sublines "$lead" $color_on $reserve "$commit" "$skey" $diff_args
                        (( ${#reply} )) && rendered="${rendered}"$'\n'"${(F)reply}"
                    fi
                    r_line+=("$rendered"); r_rank+=("$rank"); r_name+=("$skey")
                done
                # Order within a rank by filename in C/byte order, matching how git
                # sorts `git status` / `git diff --stat`. LC_ALL=C avoids locale
                # collation (which would sort e.g. 'g' before 'P' or mishandle
                # punctuation) — and must be LC_ALL, not LC_COLLATE: an LC_ALL
                # inherited from the environment (DSM's /etc/profile exports
                # en_US.utf8) outranks LC_COLLATE. It's a function-local,
                # restored on return.
                local LC_ALL=C
                local -a marked=()
                local g= i=
                for g in 1 2 3 4 5 6 7 8 9; do
                    # Key each line with its (full-path) sort name plus a tab, sort,
                    # then strip the key back off.
                    local -a group=()
                    for ((i = 1; i <= ${#r_line}; i++)); do
                        [[ ${r_rank[i]} == $g ]] && group+=("${r_name[i]}"$'\t'"${r_line[i]}")
                    done
                    group=("${(o)group[@]}")
                    local entry=
                    for entry in $group; do
                        # (@f) splits a bundled submodule entry back into its S
                        # line + sub-lines; a plain entry stays a single line.
                        marked+=("${(@f)${entry#*$'\t'}}")
                    done
                done
                STAT_BODY=("${marked[@]}")
            fi
        fi
    } always {
        [[ -n $tmp_index ]] && rm -f "$tmp_index"
    }
}

function commit_header {
    # Print one commit's header row. $1 index into the metadata arrays, $2 node
    # symbol, $3 gutter prefix, $4 hash color, $5 text color ('' for none),
    # $6 compact (1 drops the author). Reads main's metadata arrays and C_*
    # palette via zsh dynamic scoping, plus REPLY-style helpers
    # reltime/filter_refs.
    local i=$1 symbol=$2 g=$3 hash_color=$4 text_color=$5 compact=$6
    local text_reset=
    [[ -n $text_color ]] && text_reset=$C_RESET

    reltime ${epochs[$i]}
    local time_str=$REPLY
    filter_refs "${refs[$i]}"
    local refs_clean=$REPLY

    # Color each ref by kind, following sapling's defaults: the active local branch
    # ($ACTIVE_BRANCH, the "name*" token) is yellow, remote bookmarks green, and
    # local branch names attached by -b cyan — a deliberate deviation from
    # sapling's green sl.book, so local branches stand apart from remote refs.
    # Quote the ACTIVE_BRANCH RHS so its trailing "*" matches literally.
    local -a colored=()
    local rt=
    for rt in ${(s: :)refs_clean}; do
        if [[ $rt == "$ACTIVE_BRANCH" ]]; then
            colored+=("${C_BRANCH}${rt}${C_RESET}")
        else
            colored+=("${C_REF}${rt}${C_RESET}")
        fi
    done
    for rt in ${(o)${=attach_names[${all_shas[$i]}]:-}}; do
        colored+=("${C_LOCAL}${rt}${C_RESET}")
    done
    local ref_display=
    (( ${#colored} )) && ref_display="  ${(j: :)colored}"

    # -p/--prs: tag the row's shown branch names that have a PR with "#N",
    # colored by PR state. Candidates are REF_BRANCHES from filter_refs (the
    # active branch, remote bookmarks) plus the -b names attached above.
    # The trunk's branch is skipped (its merged PR would tag every base row);
    # dedupe by PR number so a local+remote pair tags once.
    local pr_seg=
    if (( ${#pr_num} )); then
        local -a pr_tags=()
        local -A pr_seen=()
        local cand= pn= pcol= ptext=
        for cand in $REF_BRANCHES ${(o)${=attach_names[${all_shas[$i]}]:-}}; do
            [[ $cand == $trunk_name ]] && continue
            pn=${pr_num[$cand]:-}
            [[ -z $pn || -n ${pr_seen[$pn]:-} ]] && continue
            pr_seen[$pn]=1
            case ${pr_state[$cand]} in
                OPEN)   pcol=$C_PR_OPEN ;;
                DRAFT)  pcol=$C_PR_DRAFT ;;
                MERGED) pcol=$C_PR_MERGED ;;
                *)      pcol=$C_PR_CLOSED ;;
            esac
            # On a color-capable TTY the tag is also an OSC 8 hyperlink to the
            # PR — same gate as the palette, so piped output stays plain text.
            ptext="#${pn}"
            (( color_on )) && [[ -n ${pr_url[$cand]:-} ]] &&
                ptext=$'\e]8;;'"${pr_url[$cand]}"$'\e\\'"${ptext}"$'\e]8;;\e\\'
            pr_tags+=("${pcol}${ptext}${C_RESET}")
        done
        (( ${#pr_tags} )) && pr_seg="  ${(j: :)pr_tags}"
    fi

    local author_seg="  ${authors[$i]}"
    (( compact )) && author_seg=

    # The hash splits at its shortest unique prefix (abbrev_hash): that much
    # stays in the hash color, the digits past it go dim, so the row shows how
    # much of it you need to type — jj's id rendering. Purely a color effect;
    # with the palette off both halves print the same and the hash is the flat
    # string it always was.
    local hash_seg="${hash_color}${hashes[$i]}${C_RESET}"
    local -i hu=${hash_uniq[$i]}
    if (( hu < ${#hashes[$i]} )); then
        hash_seg="${hash_color}${hashes[$i][1,hu]}${C_RESET}${C_DIM}${hashes[$i][hu+1,-1]}${C_RESET}"
    fi

    print -r -- "${g}${symbol}  ${hash_seg}${text_color}  ${time_str}${author_seg}${text_reset}${ref_display}${pr_seg}"
}

function subtree_epoch {
    # REPLY = newest commit epoch in the -b draft subtree rooted at $1.
    # Memoized in main's sub_epoch assoc (dynamic scoping); used to order
    # sibling subtrees and trees newest-first.
    local c=$1
    if [[ -n ${sub_epoch[$c]} ]]; then
        REPLY=${sub_epoch[$c]}
        return
    fi
    local best=${epochs[${midx[$c]}]}
    local k=
    for k in ${=tree_kids[$c]:-}; do
        subtree_epoch $k
        (( REPLY > best )) && best=$REPLY
    done
    sub_epoch[$c]=$best
    REPLY=$best
}

function draft_subject {
    # REPLY = "  subject" for draft commit $1, in HEAD-text color when $1 is
    # HEAD (and the @ hasn't moved to a wdir node).
    local c=$1
    local tc=
    [[ $c == $head_sha ]] && (( ! has_changes )) && tc=$C_HEAD_TEXT
    empty_tag $c
    REPLY="  ${REPLY}${tc}${subjects[${midx[$c]}]}${tc:+$C_RESET}"
}

function print_commit_stat {
    # Print the -c per-file stat body registered for commit $1 (if any)
    # directly under its subject row. $2 = the spine prefix carrying that
    # column downward. Reads main's commit_stats via dynamic scoping; body
    # lines are stored newline-joined (none of them can contain a newline).
    local lines=${commit_stats[$1]:-}
    [[ -z $lines ]] && return
    local line=
    for line in ${(f)lines}; do
        print -r -- "$2 ${line}"
    done
}

function emit_subtree {
    # -b renderer: print the draft subtree rooted at $1 top-down, ending with
    # $1's header row. The caller owns $1's subject row — a "│  subject"
    # continuation when $1 sits under another draft, or the join bend when $1
    # closes a column. $2 is the row prefix of this subtree's column (the trunk
    # gutter plus one "│ " per enclosing draft column).
    #
    # Layout follows sapling's renderdag (verified against its output when this
    # was written): at a fork,
    # the spine child — the one on HEAD's path, else the newest subtree —
    # continues this column straight up; every other child renders as its own
    # complete column one level deeper, newest first, closing with a ├─╯ bend
    # right above the fork commit. Chains stay contiguous, so joins only ever
    # bend the innermost open column into its parent's.
    local c=$1 prefix=$2
    local -a kids=(${=tree_kids[$c]:-})
    if (( ${#kids} )); then
        local spine_kid= k= kep= kbest=
        for k in $kids; do
            [[ -n ${on_head_path[$k]} ]] && spine_kid=$k
        done
        if [[ -z $spine_kid ]]; then
            kbest=-1
            for k in $kids; do
                subtree_epoch $k
                kep=$REPLY
                if (( kep > kbest )) || { (( kep == kbest )) && [[ $k > $spine_kid ]]; }; then
                    spine_kid=$k
                    kbest=$kep
                fi
            done
        fi
        local -a sides=(${kids:#$spine_kid}) sorted=()
        local pick= pbest=
        while (( ${#sides} )); do
            pick=${sides[1]}
            subtree_epoch $pick
            pbest=$REPLY
            for k in ${sides[2,-1]}; do
                subtree_epoch $k
                kep=$REPLY
                if (( kep > pbest )) || { (( kep == pbest )) && [[ $k > $pick ]]; }; then
                    pick=$k
                    pbest=$kep
                fi
            done
            sorted+=("$pick")
            sides=(${sides:#$pick})
        done
        emit_subtree $spine_kid "$prefix"
        draft_subject $spine_kid
        print -r -- "${prefix}│${REPLY}"
        print_commit_stat $spine_kid "${prefix}│"
        print -r -- "${prefix}│"
        for k in $sorted; do
            emit_subtree $k "${prefix}│ "
            draft_subject $k
            # Same in-column rule as the stack's bottom draft: a stat body
            # (and then its subject too) stays in the side column, closed by
            # a bare ├─╯ bend. (Unreachable while -a scopes to the current
            # branch — side subtrees are never on HEAD's path.)
            if [[ -n ${commit_stats[$k]:-} ]]; then
                print -r -- "${prefix}│ │${REPLY}"
                print_commit_stat $k "${prefix}│ │"
                print -r -- "${prefix}├─╯"
            else
                print -r -- "${prefix}├─╯${REPLY}"
            fi
            print -r -- "${prefix}│"
        done
    fi
    # The wdir node draws directly above HEAD, at HEAD's depth — with -b the @
    # can sit mid-tree, under stacked branches.
    if (( has_changes )) && [[ $c == $head_sha ]]; then
        local wdir_text_reset=
        [[ -n $C_HEAD_TEXT ]] && wdir_text_reset=$C_RESET
        print -r -- "${prefix}@  ${C_DRAFT_HASH}Uncommitted changes${C_RESET}${C_HEAD_TEXT}  ${wdir_summary}${wdir_text_reset}"
        local stat_line=
        for stat_line in $wdir_stat; do
            print -r -- "${prefix}│ ${stat_line}"
        done
        print -r -- "${prefix}│"
    fi
    draft_node $c
    local symbol=$REPLY text_color=
    if [[ $c == $head_sha ]] && (( ! has_changes )); then
        symbol=@
        text_color=$C_HEAD_TEXT
    fi
    commit_header ${midx[$c]} $symbol "$prefix" "$C_DRAFT_HASH" "$text_color" 0
}

function main {
    # Option parsing (zparseopts is a zsh builtin). Operates on main's own
    # positional params ("$@").
    local -a ARG_FULL=() ARG_BASE=() ARG_CHANGES=() ARG_BRANCHES=() ARG_PRS=() ARG_NO_PRS=() ARG_INTERACTIVE=() ARG_CD=() ARG_HELP=()
    zparseopts -D -E -- \
        C+:=ARG_CD \
        {f,-full}=ARG_FULL \
        -base:=ARG_BASE \
        {c,-changes}=ARG_CHANGES \
        {b,-branches}=ARG_BRANCHES \
        {p,-prs}=ARG_PRS \
        {P,-no-prs}=ARG_NO_PRS \
        {i,-interactive}=ARG_INTERACTIVE \
        {h,-help}=ARG_HELP \
        || { smartlog_usage >&2; exit 2; }
    (( ${#ARG_HELP} )) && { smartlog_usage; exit 0; }
    # -E leaves anything unrecognized (e.g. --bogus) in the positionals; we take no
    # positional args, so treat leftovers as a usage error.
    (( $# )) && { print -ru2 -- "$PROG: unexpected argument: $1"; smartlog_usage >&2; exit 2; }
    cd_dash_C $ARG_CD
    # --git-dir, not --is-inside-work-tree: a bare repo has no worktree but its
    # history still renders (only the uncommitted node needs one). Checked here
    # so a mistyped -C says so, instead of failing later as a missing trunk.
    git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
    cd_toplevel
    # The view flags are orthogonal: -c adds a change body to every commit in
    # view AND to the uncommitted node, -b brings in the other local branches as
    # full stacks, -f stops abbreviating. The uncommitted NODE is not a flag at
    # all — it draws whenever the working tree is dirty; -c only governs whether
    # it lists its files.
    local show_changes=0
    (( ${#ARG_CHANGES} )) && show_changes=1
    local show_branches=0
    (( ${#ARG_BRANCHES} )) && show_branches=1
    # -f is the single "don't abbreviate anything" switch, covering every place
    # this renderer shortens what it has: the public column stops at the base
    # (streams on instead), a submodule entry folds its tail into "… +N more"
    # (uncapped instead), and another author's public commit renders
    # metadata-only (full header instead).
    local full=0
    (( ${#ARG_FULL} )) && full=1
    # -p is sticky per repo: an explicit -p drops a marker file in the git dir
    # (smartlog-pr-on, beside the PR cache — nothing needs gitignoring) so
    # later runs tag PRs without the flag; an explicit -P/--no-prs removes the
    # marker and turns tagging off, winning over -p when both are given. With
    # neither flag, the marker decides. prs_explicit distinguishes flag-driven
    # tagging (missing gh dies, as before) from marker-driven (missing gh only
    # warns — a plain run must keep working on a machine without gh). Outside
    # a repo --git-path fails; the empty marker path skips all of this and the
    # repo checks below still die with their own messages.
    local show_prs=0 prs_explicit=0
    (( ${#ARG_PRS} || ${#ARG_NO_PRS} )) && prs_explicit=1
    (( ${#ARG_PRS} )) && show_prs=1
    (( ${#ARG_NO_PRS} )) && show_prs=0
    local pr_marker=$(git rev-parse --git-path smartlog-pr-on 2>/dev/null)
    if [[ -n $pr_marker ]]; then
        if (( ${#ARG_NO_PRS} )); then
            rm -f -- "$pr_marker" 2>/dev/null
        elif (( ${#ARG_PRS} && $+commands[gh] )); then
            # Don't remember a -p that is about to die on the gh check below —
            # a broken preference would make every later plain run warn.
            : >| "$pr_marker" 2>/dev/null
        elif [[ -f $pr_marker ]]; then
            show_prs=1
        fi
    fi

    local base_arg=
    (( ${#ARG_BASE} > 0 )) && base_arg=${ARG_BASE[-1]}

    # -i needs a terminal on stdout AND a readable /dev/tty for keys; without
    # either it silently degrades to the plain paged render, the same way
    # run_paged itself declines to page a pipe — so a scripted or captured
    # `git smartlog -i` is just `git smartlog`.
    local interactive=0
    (( ${#ARG_INTERACTIVE} )) && interactive=1
    if (( interactive && TTY_OUT )) && { : <>/dev/tty; } 2>/dev/null; then
        smartlog_tui
    else
        run_paged smartlog_render
    fi
}

function smartlog_render {
    # The whole smartlog view for one flag tuple. Split out of main so it can
    # be invoked more than once per process; it takes no arguments and touches
    # no ARG_* array — it reads the parse half's locals (show_changes,
    # show_branches, full, show_prs, prs_explicit, base_arg) via dynamic
    # scoping, the same mechanism render_plan and the other helpers already
    # lean on. Every array and palette it builds is local, so re-entry gets a
    # clean slate.

    # -f lifts the submodule sub-line cap; set it BOTH ways so a re-render in
    # the same shell (a toggle turning -f back off) gets the default back —
    # same discipline as the STAT_WANT_BODY save/restore below.
    if (( full )); then SUBLINE_CAP=0; else SUBLINE_CAP=10; fi

    NOW=$EPOCHSECONDS
    local today
    strftime -s today '%Y-%m-%d' $NOW
    strftime -rs TODAY_MIDNIGHT '%Y-%m-%d %H:%M:%S' "$today 00:00:00"
    strftime -s CURRENT_YEAR '%Y' $NOW

    # For sapling's compact-public-node rule: a public, non-HEAD commit authored
    # by someone else renders metadata-only. Compared against the configured user.
    # Skipped under -f/--full, where nothing is ever compacted.
    local my_email=
    (( ! full )) && my_email=$(git config user.email 2>/dev/null)

    # The active local branch (HEAD's) is shown with a trailing "*", like sapling's
    # active bookmark — but only when no remote branch of the same name exists. If
    # one does, sapling shows just the remote bookmark (e.g. on `master`, only
    # origin/master appears, never master*). Detached HEAD has no active branch.
    ACTIVE_BRANCH=
    local cur_branch
    cur_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
    if [[ -n $cur_branch ]] &&
       [[ -z $(git for-each-ref --count=1 --format=x "refs/remotes/*/${cur_branch}" 2>/dev/null) ]]; then
        ACTIVE_BRANCH="${cur_branch}*"
    fi

    local base_ref
    if [[ -n $base_arg ]]; then
        base_ref=$(resolve_base "$base_arg") ||
            die "Cannot resolve --base $base_arg"
    else
        base_ref=$(resolve_base "") ||
            die "Cannot find a public base ref (no remote trunk, @{u}, or local main/master)"
    fi

    local head_sha
    head_sha=$(git rev-parse HEAD 2>/dev/null) ||
        die "HEAD is not a valid commit"

    local merge_base
    merge_base=$(git merge-base HEAD "$base_ref" 2>/dev/null) ||
        die "No merge-base between HEAD and $base_ref"

    # -p/--prs: one `gh pr list` call up front maps head branch -> PR number +
    # state; commit_header consults the maps per row. State folds isDraft into
    # DRAFT; a branch with several PRs keeps an open one over closed/merged,
    # else the newest (gh lists newest first). trunk_name is the base branch's
    # bare name, excluded from tagging in commit_header. gh is this script's
    # only dependency beyond zsh+git, gated behind the flag: absent gh dies, a
    # failed listing (non-GitHub remote, unauthenticated) warns and renders
    # without tags.
    local -A pr_num pr_state pr_url
    local trunk_name=${base_ref#*/}
    if (( show_prs )) && ! (( $+commands[gh] )); then
        # Explicit -p keeps the hard error; the sticky marker alone must not
        # break plain runs on a machine without gh.
        (( prs_explicit )) && die "--prs needs the GitHub CLI (gh) on PATH"
        print -ru2 -- "$PROG: warning: PR tagging is remembered for this repo but gh is missing; skipping (use -P to forget)"
        show_prs=0
    fi
    if (( show_prs )); then
        # The gh call costs ~1s+ of API round-trip, so its TSV output is cached
        # per repo (inside the git dir, so nothing needs gitignoring) with a
        # short TTL — $GIT_SMARTLOG_PR_TTL seconds, default 60, 0 forces a
        # refetch. The
        # write is atomic (temp + rename beside it) so concurrent runs never
        # read a half-written file; only a successful listing is cached, and a
        # failed one (offline, unauthenticated) falls back to the stale cache
        # when there is one — better a minute-old PR map than none.
        local cache_file=$(git rev-parse --git-path smartlog-pr-cache)
        local ttl=${GIT_SMARTLOG_PR_TTL:-60}
        local pr_data=
        local -a cache_mtime=()
        if [[ -f $cache_file ]] && zstat -A cache_mtime +mtime -- "$cache_file" 2>/dev/null &&
           (( EPOCHSECONDS - cache_mtime[1] < ttl )); then
            pr_data=$(<"$cache_file")
        elif pr_data=$(gh pr list --state all --limit 200 \
            --json number,state,isDraft,headRefName,url \
            --jq '.[] | [.headRefName, .number, .state, .isDraft, .url] | @tsv' 2>/dev/null); then
            { print -r -- "$pr_data" > "${cache_file}.$$" 2>/dev/null &&
                mv -f "${cache_file}.$$" "$cache_file" 2>/dev/null; } ||
                rm -f "${cache_file}.$$" 2>/dev/null
        elif [[ -f $cache_file ]]; then
            pr_data=$(<"$cache_file")
            print -ru2 -- "$PROG: warning: 'gh pr list' failed; showing cached PR numbers"
        else
            print -ru2 -- "$PROG: warning: 'gh pr list' failed (not a GitHub repo, or gh not authenticated); no PR numbers shown"
        fi
        local pb= pn= ps= pd= pu=
        while IFS=$'\t' read -r pb pn ps pd pu; do
            [[ -z $pb ]] && continue
            [[ $ps == OPEN && $pd == true ]] && ps=DRAFT
            if [[ -z ${pr_num[$pb]:-} ]] ||
               [[ ${pr_state[$pb]} != (OPEN|DRAFT) && $ps == (OPEN|DRAFT) ]]; then
                pr_num[$pb]=$pn
                pr_state[$pb]=$ps
                pr_url[$pb]=$pu
            fi
        done <<< "$pr_data"
    fi

    # Uncommitted working-tree changes render as a synthetic "Uncommitted changes"
    # node on top of HEAD; the @ marker moves there, since that's where the working
    # copy actually is. The stat block is computed by uncommitted_stat (the very
    # same code the standalone `git-smartstat` runs) — we just consume its
    # REPLY-style globals. Color matches the C_* palette gate below.
    local color_on=0
    (( TTY_OUT )) && [[ -z $NO_COLOR ]] && color_on=1

    # The node's summary always draws; its per-file body is -c's, same as every
    # commit's. Without -c, tell uncommitted_stat to stop once it has the
    # summary — the body it would build is the expensive half (a submodule
    # entry alone forks per submodule to expand its sub-lines).
    (( show_changes )) || STAT_WANT_BODY=0

    local has_changes=0 wdir_summary=
    local -a wdir_stat
    uncommitted_stat $color_on 4       # body lines are indented "  │ " in the node
    STAT_WANT_BODY=1                   # scoped to that one call
    has_changes=$STAT_HAS_CHANGES
    wdir_summary=$STAT_SUMMARY
    wdir_stat=("${STAT_BODY[@]}")

    local -a drafts
    if [[ $head_sha != $merge_base ]]; then
        drafts=("${(@f)$(git rev-list --first-parent HEAD "^$merge_base")}")
    fi

    # -b/--branches: collect every other local branch. A branch merged into the
    # trunk just labels its public commit (attach_names); every other one is
    # queued for the draft forest below, which renders its complete stack. A
    # branch whose same-name remote ref sits at the same commit keeps its local
    # name hidden, mirroring the ACTIVE_BRANCH rule above (the remote ref, which
    # %D still carries, already identifies it).
    local -A attach_names
    local -a extra_publics=()
    # The forest: every draft commit reachable first-parent from any head, its
    # first parent, its draft children, and the tree roots grouped by the public
    # commit they hang off.
    local -A in_draft first_parent tree_kids roots_at
    local -a bfull_heads=() bfull_forks=()
    if (( show_branches )); then
        # for-each-ref's format language has no %x1f escape (that's pretty-format
        # only); a space separator is safe — ref names cannot contain spaces.
        local -A remote_tip
        local rn= rs=
        while read -r rn rs; do
            [[ -n $rn ]] && remote_tip[$rn]=$rs
        done < <(git for-each-ref --format='%(refname:short) %(objectname)' refs/remotes 2>/dev/null)

        local bname= bhead= fork= rk= name_hidden=
        while read -r bname bhead; do
            [[ -z $bname || $bname == "$cur_branch" ]] && continue
            fork=$(git merge-base "$bhead" "$base_ref" 2>/dev/null) || continue
            name_hidden=0
            for rk in ${(k)remote_tip}; do
                if [[ $rk == */"$bname" && ${remote_tip[$rk]} == $bhead ]]; then
                    name_hidden=1
                    break
                fi
            done
            if [[ $bhead == $fork ]]; then
                # merged into the trunk: label its public commit instead
                (( name_hidden )) || attach_names[$bhead]+="$bname "
                extra_publics+=("$fork")
                continue
            fi
            # The head commit itself will be on screen — its name always
            # attaches; queue the chain for the forest built below.
            (( name_hidden )) || attach_names[$bhead]+="$bname "
            bfull_heads+=("$bhead")
            bfull_forks+=("$fork")
        done < <(git for-each-ref --format='%(refname:short) %(objectname)' refs/heads 2>/dev/null)
    fi

    # Union every head's first-parent chain into a forest. Shared prefixes
    # dedup via in_draft (a chain stops as soon as it meets a known commit), so
    # branches forking from a draft — or containing HEAD, i.e. stacked above it —
    # come out as one tree with fork nodes. Each
    # tree's root hangs off the public commit its first parent points at (which
    # joins the shown publics); HEAD's own chain is walked first so the tree
    # containing HEAD prefers its path as the spine.
    if (( show_branches )); then
        local -a fheads=("$head_sha" $bfull_heads) fforks=("$merge_base" $bfull_forks)
        local -i fx=0
        local fline=
        local -a fw
        for ((fx = 1; fx <= ${#fheads}; fx++)); do
            [[ ${fheads[fx]} == ${fforks[fx]} ]] && continue      # no drafts (HEAD on trunk)
            [[ -n ${in_draft[${fheads[fx]}]} ]] && continue       # chain already absorbed
            while IFS= read -r fline; do
                fw=(${=fline})                                     # sha first-parent [more...]
                [[ -n ${in_draft[${fw[1]}]} ]] && break            # rest is shared prefix
                in_draft[${fw[1]}]=1
                first_parent[${fw[1]}]=${fw[2]:-}
            done < <(git rev-list --first-parent --parents ${fheads[fx]} "^${fforks[fx]}" 2>/dev/null)
        done
        local dc= dp=
        for dc in ${(k)in_draft}; do
            dp=${first_parent[$dc]}
            [[ -z $dp ]] && continue
            if [[ -n ${in_draft[$dp]} ]]; then
                tree_kids[$dp]+="$dc "
            else
                roots_at[$dp]+="$dc "
                extra_publics+=("$dp")
            fi
        done
    fi

    # Which drafts are already on a remote. Deliberately NOT jj's immutability
    # line, which excludes remote bookmarks you TRACK precisely because
    # rewriting your own pushed branch is routine — painting a whole PR stack as
    # frozen would be worse than saying nothing. So this claims the weaker, true
    # thing: the commit is out there, and rewriting it now costs a force-push.
    # Drawn as the middle step of the node ramp (o → ◇ → ◆), not as a color:
    # \e[33m and \e[93m are the same yellow to the eye in Dracula and most
    # 16-color themes, so a color-only mark was invisible in practice.
    #
    # One call: rev-list of the draft heads --not --remotes prints every draft
    # NOT reachable from a remote-tracking ref, so the drafts it omits are the
    # pushed ones. --no-walk does NOT restrict that to the argument set (with
    # --not in play git walks anyway, stopping at the remote boundary — which is
    # what bounds the walk to the unpushed set), so intersect against the draft
    # list rather than reading the output as the input. Skipped outright in a
    # repo with no remote refs, where --not excludes nothing and the walk would
    # cover all of history just to answer "none of them".
    local -A pushed=()
    local -a draft_all=()
    if (( show_branches )); then draft_all=(${(k)in_draft}); else draft_all=($drafts); fi
    if (( ${#draft_all} )) && [[ -n $(git for-each-ref --count=1 refs/remotes 2>/dev/null) ]]; then
        local -A unpushed=()
        local uc= dsha=
        while IFS= read -r uc; do
            [[ -n $uc ]] && unpushed[$uc]=1
        done < <(git rev-list $head_sha $bfull_heads --not --remotes 2>/dev/null)
        for dsha in $draft_all; do
            [[ -n ${unpushed[$dsha]} ]] || pushed[$dsha]=1
        done
    fi

    local -a publics
    if (( show_branches )); then
        # Shown publics: the -n window from the trunk tip, plus the merge-base
        # and every branch's fork point (which can sit far below the window),
        # ordered along the trunk by one topo-order walk down to their common
        # ancestor. Neighbors that aren't parent/child render with the dotted ╷
        # spine between them.
        local -a shown
        shown=("${(@f)$(git rev-list --first-parent "$base_ref" -n 1)}")
        shown+=("$merge_base" $extra_publics)
        shown=(${(u)shown})
        if (( ${#shown} > 1 )); then
            local walk_base=
            walk_base=$(git merge-base --octopus $shown 2>/dev/null)
            local -a ordered=()
            [[ -n $walk_base ]] &&
                ordered=("${(@f)$(git rev-list --topo-order $shown "^$walk_base" 2>/dev/null)}")
            publics=()
            local os=
            for os in $ordered; do
                (( ${shown[(Ie)$os]} )) && publics+=("$os")
            done
            # walk_base itself (excluded by ^walk_base above) — or everything,
            # if the octopus/walk failed: append whatever the walk didn't order.
            for os in $shown; do
                (( ${publics[(Ie)$os]} )) || publics+=("$os")
            done
        else
            publics=($shown)
        fi
    else
        publics=("${(@f)$(git rev-list --first-parent "$base_ref" -n 1)}")
        # If base_ref is ahead of HEAD's branch, anchor public column at merge_base instead.
        if [[ ${publics[(Ie)$merge_base]} -eq 0 ]]; then
            publics=("${(@f)$(git rev-list --first-parent "$merge_base" -n 1)}")
        fi
    fi

    local C_PUBLIC_HASH= C_DRAFT_HASH= C_HEAD_TEXT= C_REF= C_BRANCH= C_LOCAL= C_DIM= C_RESET=
    local C_PR_OPEN= C_PR_DRAFT= C_PR_MERGED= C_PR_CLOSED=
    if (( TTY_OUT )) && [[ -z $NO_COLOR ]]; then
        C_PUBLIC_HASH=$'\e[33m'
        C_DRAFT_HASH=$'\e[93;1m'
        C_HEAD_TEXT=$'\e[35m'
        C_REF=$'\e[32m'
        C_BRANCH=$'\e[33m'
        C_LOCAL=$'\e[36m'
        C_DIM=$'\e[2m'
        C_RESET=$'\e[0m'
        C_PR_OPEN=$'\e[34m'     # open — blue, distinct from green remote refs
        C_PR_DRAFT=$'\e[2;34m'  # draft — dim blue
        C_PR_MERGED=$'\e[35m'   # merged — magenta (GitHub purple)
        C_PR_CLOSED=$'\e[31m'   # closed — red
    fi

    # -c: per-commit stat bodies, drawn under the owning commit's subject row by
    # print_commit_stat. It covers every draft in the current stack, clean or
    # dirty — or, when HEAD sits directly on the trunk (no drafts), every public
    # commit in view (pair with -n) — with the wdir node still on top when the
    # tree is dirty. Each body ends with a dim "N files, +X -Y" total line (the
    # wdir node carries that total in its header instead).
    local -A commit_stats=()
    local -a stat_targets=()
    if (( show_changes )); then
        stat_targets=($drafts)
        (( ${#stat_targets} )) || stat_targets=($publics)
    fi

    local -a all_shas
    if (( show_branches )); then
        all_shas=(${(k)in_draft} "${publics[@]}")
    else
        all_shas=("${drafts[@]}" "${publics[@]}")
    fi
    (( ${#all_shas} == 0 )) && die "Nothing to display"

    # --abbrev=4 asks for the shortest UNIQUE abbreviation rather than a fixed
    # width (git's floor is 4 and it widens from there until the prefix names
    # one object); the displayed HASH_WIDTH-digit hash is cut from %H instead,
    # so both halves of abbrev_hash's split come out of this one pass. %T rides
    # along for the (empty) check below.
    local commit_data
    commit_data=$(git log --no-walk=unsorted --abbrev=4 --decorate=full \
        --pretty=format:'%H%x1f%h%x1f%T%x1f%at%x1f%al%x1f%ae%x1f%D%x1f%P%x1f%s' "${all_shas[@]}")

    local -a hashes hash_uniq trees epochs authors author_emails refs parents subjects
    local fh h t e a ae r p s
    while IFS=$'\x1f' read -r fh h t e a ae r p s; do
        [[ -z $fh ]] && continue
        abbrev_hash $fh $h
        hashes+=("$REPLY")
        hash_uniq+=($REPLY_UNIQ)
        trees+=("$t")
        epochs+=("$e")
        authors+=("$a")
        author_emails+=("$ae")
        refs+=("$r")
        parents+=("$p")
        subjects+=("$s")
    done <<< "$commit_data"

    # sha -> index into the metadata arrays (the render plan is sha-driven).
    local -A midx
    local -i mi=0
    for ((mi = 1; mi <= ${#all_shas}; mi++)); do
        midx[${all_shas[mi]}]=$mi
    done

    # (empty) marking: a commit is empty when its tree matches its first
    # parent's — the same "changed nothing" -c's body test already answers, but
    # from trees, so it costs no diff. Most parents are shown commits and came
    # with the pass above; the few outside the window (the bottom public's
    # parent, and whatever a ╷ elision jumped over) are fetched in one batch
    # rather than a rev-parse per row.
    local -A tree_of=() is_empty=()
    local empty_tree= p1=
    local -a want_trees=()
    for ((mi = 1; mi <= ${#all_shas}; mi++)); do
        tree_of[${all_shas[mi]}]=${trees[mi]}
    done
    for ((mi = 1; mi <= ${#all_shas}; mi++)); do
        p1=${parents[mi]%% *}
        [[ -n $p1 && -z ${tree_of[$p1]:-} ]] && want_trees+=("$p1")
    done
    if (( ${#want_trees} )); then
        local pt_sha= pt_tree=
        while IFS=$'\x1f' read -r pt_sha pt_tree; do
            [[ -n $pt_sha ]] && tree_of[$pt_sha]=$pt_tree
        done < <(git log --no-walk=unsorted --pretty=tformat:'%H%x1f%T' "${want_trees[@]}")
    fi
    for ((mi = 1; mi <= ${#all_shas}; mi++)); do
        p1=${parents[mi]%% *}
        if [[ -z $p1 ]]; then
            # A root commit is empty against the empty tree — the same thing -c
            # diffs it against. Asked for lazily and once: it costs a fork, and
            # a root commit is only ever in view at the very bottom of history.
            [[ -z $empty_tree ]] && empty_tree=$(git hash-object -t tree /dev/null)
            [[ ${trees[mi]} == $empty_tree ]] && is_empty[${all_shas[mi]}]=1
        elif [[ ${trees[mi]} == ${tree_of[$p1]:-} ]]; then
            is_empty[${all_shas[mi]}]=1
        fi
    done

    # -c bodies. Deliberately after the metadata fetch above: every target is in
    # it, so its %P gives the first parent uncommitted_stat would otherwise fork
    # a `rev-parse` per row to learn.
    local st_sha=
    for st_sha in $stat_targets; do
        uncommitted_stat $color_on 4 $st_sha ${parents[${midx[$st_sha]}]%% *}
        (( STAT_HAS_CHANGES )) || continue   # empty commit: no body
        local -a st_body=("${STAT_BODY[@]}" " ${C_DIM}${STAT_SUMMARY}${C_RESET}")
        commit_stats[$st_sha]=${(F)st_body}
    done

    local n_drafts=${#drafts}

    # Render plan: walk the public column top-down. The current draft stack
    # (with its optional wdir node) renders above merge_base; each -b branch
    # head renders as a single node above its fork point, after the stack when
    # they share one. Between rows, `spine` tracks what the gutter column
    # carries at that point: '' above the topmost public, '│' solid
    # (parent/child adjacent), '╷' dotted (commits elided between). Stack and
    # branch rows take the matching gutter prefix, and their join row bends
    # ╭─╯ off a dotted-or-empty spine but forks ├─╯ off a solid one, the way
    # sapling's renderdag does.
    # -b: mark HEAD's first-parent path (spine preference), find HEAD's tree
    # root, and memoize per-subtree newest epochs for ordering.
    local -A on_head_path sub_epoch
    local head_root=
    if (( show_branches )) && [[ -n ${in_draft[$head_sha]} ]]; then
        head_root=$head_sha
        on_head_path[$head_root]=1
        while [[ -n ${first_parent[$head_root]} && -n ${in_draft[${first_parent[$head_root]}]} ]]; do
            head_root=${first_parent[$head_root]}
            on_head_path[$head_root]=1
        done
    fi

    local -a plan=()
    local pp= bh=
    for pp in $publics; do
        if (( show_branches )); then
            # wdir-only pseudo-stack when HEAD sits on a public commit
            [[ $pp == $merge_base && -z $head_root ]] && (( has_changes )) && plan+=(stack)
            # Trees hanging off this public: HEAD's tree first (topmost, like
            # the single-stack layout), the rest newest-subtree first.
            local -a proots=(${=roots_at[$pp]:-}) tordered=()
            local tpick= tbest= tep=
            if (( ${proots[(Ie)$head_root]} )); then
                tordered+=("$head_root")
                proots=(${proots:#$head_root})
            fi
            while (( ${#proots} )); do
                tpick=${proots[1]}
                subtree_epoch $tpick; tbest=$REPLY
                for bh in ${proots[2,-1]}; do
                    subtree_epoch $bh; tep=$REPLY
                    if (( tep > tbest )) || { (( tep == tbest )) && [[ $bh > $tpick ]]; }; then
                        tpick=$bh
                        tbest=$tep
                    fi
                done
                tordered+=("$tpick")
                proots=(${proots:#$tpick})
            done
            for bh in $tordered; do
                plan+=("tree:$bh")
            done
        else
            [[ $pp == $merge_base ]] && plan+=(stack)
        fi
        plan+=("public:$pp")
    done

    # The planned window, then its final row: the "~" truncation marker — or,
    # with -f, the streamed-history tail (unless the bottom shown public IS
    # the root commit, in which case nothing is truncated to stream).
    render_plan
    if (( full )) &&
       git rev-parse --verify --quiet "${publics[-1]}^" >/dev/null 2>&1; then
        stream_public_tail ${publics[-1]}
    else
        print -r -- "~"
    fi
}

function render_plan {
    # Emit the planned render — the whole graph except its final row (the "~"
    # truncation marker, or the first spine row of the -f streamed-history
    # tail), which main appends. Reads main's plan/metadata/C_* state via
    # dynamic scoping, like the other render helpers.
    local spine= el= g= join= symbol= text_color= subject_body= seg= pp= bh=
    local -i pl_i=0 pub_i=0 n_plan=${#plan} idx=0 di=0
    local is_compact=0
    for ((pl_i = 1; pl_i <= n_plan; pl_i++)); do
        el=${plan[pl_i]}
        if [[ -n $spine ]]; then g="${spine} "; else g='  '; fi
        if [[ $spine == '│' ]]; then join='├─╯'; else join='╭─╯'; fi

        case $el in
        (stack)
            # Synthetic wdir node, drawn above the stack: @ marker, draft-colored
            # label, the change summary in HEAD-text color. It connects straight
            # down into the draft column when HEAD is a draft, otherwise it bends
            # into the public column.
            if (( has_changes )); then
                local wdir_text_reset=
                [[ -n $C_HEAD_TEXT ]] && wdir_text_reset=$C_RESET
                print -r -- "${g}@  ${C_DRAFT_HASH}Uncommitted changes${C_RESET}${C_HEAD_TEXT}  ${wdir_summary}${wdir_text_reset}"
                # stat_line already starts with one space (git's --stat lead); add
                # one more so the marker sits 2 cols past the │ spine, aligning
                # with commit text (│  subject) and the node header (@  Uncomm…).
                local stat_line=
                for stat_line in $wdir_stat; do
                    print -r -- "${g}│ ${stat_line}"
                done
                if (( n_drafts > 0 )); then
                    print -r -- "${g}│"
                else
                    print -r -- "$join"
                    print -r -- "│"
                    spine='│'
                fi
            fi
            for ((di = 1; di <= n_drafts; di++)); do
                idx=${midx[${drafts[di]}]}
                draft_node ${drafts[di]}
                symbol=$REPLY
                text_color=
                if [[ ${drafts[di]} == $head_sha ]] && (( ! has_changes )); then
                    # With uncommitted changes the @ marker belongs to the wdir
                    # node above; HEAD stays a normal node (keeps author/subject).
                    symbol=@
                    text_color=$C_HEAD_TEXT
                fi
                commit_header $idx $symbol "$g" "$C_DRAFT_HASH" "$text_color" 0
                empty_tag ${drafts[di]}
                subject_body="  ${REPLY}${text_color}${subjects[idx]}${text_color:+$C_RESET}"
                if (( di == n_drafts )); then
                    # A stat body must stay in ITS commit's column: printed
                    # after the ╭─╯ bend it would sit beside the public commit
                    # below and read as THAT commit's changes. So when the
                    # bottom draft has one, keep its subject in-column too and
                    # close with a bare bend — the same shape the wdir node
                    # takes on a public HEAD.
                    if [[ -n ${commit_stats[${drafts[di]}]:-} ]]; then
                        print -r -- "${g}│${subject_body}"
                        print_commit_stat ${drafts[di]} "${g}│"
                        print -r -- "$join"
                    else
                        print -r -- "${join}${subject_body}"
                    fi
                    print -r -- "│"
                    spine='│'
                else
                    print -r -- "${g}│${subject_body}"
                    print_commit_stat ${drafts[di]} "${g}│"
                    print -r -- "${g}│"
                fi
            done
            ;;
        (tree:*)
            # -b: a full draft tree above its fork-point public commit.
            bh=${el#tree:}
            emit_subtree $bh "$g"
            draft_subject $bh
            # Same in-column rule as the stack's bottom draft: a stat body
            # (and then its subject too) stays in the tree's column, closed
            # by a bare bend.
            if [[ -n ${commit_stats[$bh]:-} ]]; then
                print -r -- "${g}│${REPLY}"
                print_commit_stat $bh "${g}│"
                print -r -- "$join"
            else
                print -r -- "${join}${REPLY}"
            fi
            print -r -- "│"
            spine='│'
            ;;
        (public:*)
            pp=${el#public:}
            (( pub_i++ ))
            idx=${midx[$pp]}
            symbol=◆
            text_color=
            if [[ $pp == $head_sha ]] && (( ! has_changes )); then
                # With uncommitted changes the @ marker belongs to the wdir node
                # above; HEAD stays a normal node (but still gets a full,
                # non-compact header so its author/subject keep showing).
                symbol=@
                text_color=$C_HEAD_TEXT
            fi
            # Compact public node: not HEAD, authored by someone else →
            # metadata-only (no author, no subject). See header. -f/--full
            # turns this off (full=1), so every commit gets a full header.
            is_compact=0
            if (( ! full )) && [[ $pp != $head_sha && ${author_emails[idx]} != $my_email ]]; then
                is_compact=1
            fi
            commit_header $idx $symbol '' "$C_PUBLIC_HASH" "$text_color" $is_compact
            empty_tag $pp
            subject_body="  ${REPLY}${text_color}${subjects[idx]}${text_color:+$C_RESET}"
            (( is_compact )) && subject_body=
            if (( pl_i == n_plan )); then
                # The final row below this ("~" or the -f tail's spine)
                # belongs to main — see the render_plan call there.
                print -r -- "│${subject_body}"
                print_commit_stat $pp "│"
            else
                # Segment down to the next shown public: solid when it's a
                # parent of this commit, dotted ╷ when commits are elided.
                seg='╷'
                [[ " ${parents[idx]} " == *" ${publics[pub_i+1]} "* ]] && seg='│'
                print -r -- "${seg}${subject_body}"
                print_commit_stat $pp "$seg"
                print -r -- "$seg"
                spine=$seg
            fi
            ;;
        esac
    done
}

function stream_public_tail {
    # -f/--full: instead of cutting history at "~", keep the public column
    # going — walk first-parent history below the bottom shown public and emit
    # rows as the consumer takes them. Paged, that means lazily: pipe
    # backpressure keeps `git log` from walking ahead of the pager, so
    # scrolling keeps revealing older commits like plain `git log`, and a
    # pager quit kills the walk via SIGPIPE. Piped, the full history streams
    # out, also like `git log`. Rendering matches the planned public rows:
    # same compact-header rule, refs, and -c stat bodies when publics are the
    # stat targets (computed lazily, one commit at a time). Metadata appends
    # to main's arrays via dynamic scoping. Ends with "~" only at the root
    # commit; tformat (not format) terminates the last record with a newline
    # so the root commit survives the read loop.
    #
    # Rows are held one behind: in a first-parent walk the record just read IS
    # the held row's parent, so its %T is what says whether that row was empty
    # — the tail's answer to the tree lookup main does for the planned window,
    # at no fork per row. One row of buffering doesn't cost the laziness (git
    # still can't outrun the pager). The whole loop, flush included, is one
    # pipeline stage: zsh runs that in a subshell, so a flush after `done`
    # would be looking at a copy of `pend` that never got written.
    local from=$1
    print -r -- "│"
    local fsha= h= t= e= a= ae= r= p= s=
    local -a pend=()
    git log --first-parent --abbrev=4 --decorate=full \
        --pretty=tformat:'%H%x1f%h%x1f%T%x1f%at%x1f%al%x1f%ae%x1f%D%x1f%P%x1f%s' \
        "${from}^" 2>/dev/null |
    {
        local -i emitted=0
        while IFS=$'\x1f' read -r fsha h t e a ae r p s; do
            [[ -z $fsha ]] && continue
            (( ${#pend} )) && { emit_tail_row "$t" "${pend[@]}"; (( emitted += 1 )) }
            if (( TAIL_CAP && emitted >= TAIL_CAP )); then
                # Cap reached: close with the ╷ elision ("commits jumped
                # over"), NOT "~" — the root was never reached, so "~" would
                # be false. Dropping pend suppresses the root flush below;
                # breaking lets git log die of SIGPIPE on its next write, the
                # same way a pager quit already ends this walk.
                print -r -- "╷"
                pend=()
                break
            fi
            pend=("$fsha" "$h" "$t" "$e" "$a" "$ae" "$r" "$p" "$s")
        done
        # git log ran out, so the held row is the root commit (or a shallow
        # clone's graft, which has a parent we can't see and so never reads as
        # empty). Its parent tree is the empty tree. A real `if`, not `&& `:
        # a capped walk arrives here with pend empty, and this is the block's
        # last command — a failing (( 0 )) would fail the whole pipeline.
        if (( ${#pend} )); then
            emit_tail_row "$(git hash-object -t tree /dev/null)" "${pend[@]}"
        fi
    }
}

function emit_tail_row {
    # Print one row of the -f streamed tail: $1 the first parent's tree (what
    # decides the (empty) mark), then the held record — sha, unique abbrev,
    # tree, epoch, author, email, refs, parents, subject. Appends the metadata
    # to main's arrays (dynamic scoping, like the rest of the tail) so
    # commit_header reads it back by index exactly like a planned row.
    local ptree=$1 fsha=$2 h=$3 t=$4 e=$5 a=$6 ae=$7 r=$8 p=$9 s=${10}
    abbrev_hash $fsha $h
    all_shas+=("$fsha"); hashes+=("$REPLY"); hash_uniq+=($REPLY_UNIQ)
    epochs+=("$e"); authors+=("$a")
    author_emails+=("$ae"); refs+=("$r"); parents+=("$p"); subjects+=("$s")
    [[ $t == $ptree ]] && is_empty[$fsha]=1
    local -i idx=${#hashes}
    # Same compact-public rule as the plan loop; a tail commit is never
    # HEAD (HEAD sits at or above the merge-base, always in the window).
    local -i is_compact=0
    (( ! full )) && [[ $ae != $my_email ]] && is_compact=1
    if (( show_changes && ! n_drafts )); then
        uncommitted_stat $color_on 4 $fsha ${p%% *}
        if (( STAT_HAS_CHANGES )); then
            local -a st_body=("${STAT_BODY[@]}" " ${C_DIM}${STAT_SUMMARY}${C_RESET}")
            commit_stats[$fsha]=${(F)st_body}
        fi
    fi
    commit_header $idx ◆ '' "$C_PUBLIC_HASH" '' $is_compact
    empty_tag $fsha
    local subject_body="  ${REPLY}${subjects[idx]}"
    (( is_compact )) && subject_body=
    print -r -- "│${subject_body}"
    print_commit_stat $fsha "│"
    if [[ -n $p ]]; then
        print -r -- "│"
    else
        print -r -- "~"   # root commit: history exhausted
    fi
}

function smartstat_main {
    # Standalone entry point (invoked as git-smartstat): print just the uncommitted
    # stat block — a plain summary line followed by the per-file body — or nothing
    # when the working tree is clean. --color WHEN is auto (default), always, never.
    local -a ARG_COLOR=(auto) ARG_CD=() ARG_HELP=()
    zparseopts -D -E -K -- \
        C+:=ARG_CD \
        -color:=ARG_COLOR \
        {h,-help}=ARG_HELP \
        || { smartstat_usage >&2; exit 2; }
    (( ${#ARG_HELP} )) && { smartstat_usage; exit 0; }
    # -E leaves anything unrecognized (e.g. --bogus) in the positionals; we take no
    # positional args, so treat leftovers as a usage error.
    (( $# )) && { print -ru2 -- "$PROG: unexpected argument: $1"; smartstat_usage >&2; exit 2; }
    cd_dash_C $ARG_CD

    git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
        die "not a git repository"
    cd_toplevel

    # zparseopts keeps the "=" of the --color=WHEN form (--color WHEN gives a bare
    # value), so strip one leading "=" before matching.
    local when=${ARG_COLOR[-1]#=}
    local color_on=0
    case $when in
        always) color_on=1 ;;
        never)  color_on=0 ;;
        auto)   (( TTY_OUT )) && [[ -z $NO_COLOR ]] && color_on=1 ;;
        *)      print -ru2 -- "$PROG: invalid --color: $when (use auto, always, or never)"
                exit 2 ;;
    esac

    uncommitted_stat $color_on
    (( STAT_HAS_CHANGES )) || return 0
    print -r -- "$STAT_SUMMARY"
    local line
    for line in "${STAT_BODY[@]}"; do
        print -r -- "$line"
    done
}

function stream_or_print {
    # The paging decision, line-granular and stream-preserving: buffer stdin
    # only until it either ends (fits on screen → print it straight) or hits
    # ROWS lines (can't fit → replay the buffered head into the pager and let
    # the rest stream through lazily via cat, which inherits this stdin). $1 =
    # the pager command; it may carry its own arguments (core.pager often
    # does, e.g. "less -S"), so run it through eval like git does.
    local -a buf=()
    local line=
    while IFS= read -r line; do
        buf+=("$line")
        if (( ${#buf} >= ROWS )); then
            { print -rl -- "${buf[@]}"; cat; } | eval "$1"
            return
        fi
    done
    (( ${#buf} )) && print -rl -- "${buf[@]}"
}

function run_paged {
    # Run "$@" with stdout piped through stream_or_print: printed directly
    # when the output ends within the terminal height, else paged ($GIT_PAGER,
    # then git's core.pager, then $PAGER, then less) with the remainder
    # streaming through lazily (that laziness is what makes -f viable — see
    # stream_public_tail). Only engages when stdout is a TTY —
    # piped/redirected output runs the command untouched, as does
    # GIT_PAGER=cat. The pipe hides the terminal from the renderer, so color
    # and stat-width decisions inside consult TTY_OUT, probed up front.
    if (( ! TTY_OUT )); then
        "$@"
        return
    fi

    # Terminal height from the controlling terminal (same probe as the stat
    # width in uncommitted_stat), $LINES then 24 as fallbacks. An output of
    # exactly ROWS lines already scrolls once the prompt prints — page it.
    typeset -g ROWS=24
    local termsize=
    termsize=$(stty size </dev/tty 2>/dev/null)   # "rows cols"
    if [[ $termsize == <->" "<-> ]] && (( ${termsize%% *} > 0 )); then
        ROWS=${termsize%% *}
    elif [[ -n $LINES ]] && (( LINES > 0 )); then
        ROWS=$LINES
    fi

    local pager=${GIT_PAGER:-$(git config core.pager 2>/dev/null)}
    [[ -z $pager ]] && pager=${PAGER:-less}
    if [[ $pager == cat ]]; then
        "$@"
        return
    fi
    # Match git's pager defaults: F quit-if-one-screen, R pass ANSI colors
    # through, X skip termcap init/deinit (so short output isn't cleared away).
    export LESS=${LESS:-FRX}
    # pipefail so the renderer's failure survives the pipeline; a pager quit
    # mid-stream kills the renderer with SIGPIPE (141) — that's a clean exit.
    setopt local_options pipefail
    local rc=0
    "$@" | stream_or_print "$pager"
    rc=$?
    (( rc == 141 )) && rc=0
    return $rc
}

# ── Interactive mode (-i) ───────────────────────────────────────────────────
# A full-screen view over smartlog_render: c/b/f/p flip the view flags live,
# j/k & friends scroll, r refreshes, q quits. The loop runs in the main shell;
# only the renders fork — each is captured in a $(...) so a die inside can't
# take the screen down (see tui_render).

function tui_restore {
    # Leave the terminal exactly as found: cursor on, autowrap on, main
    # screen, cooked mode ($1 = the `stty -g` state saved on entry).
    # Idempotent via TUI_ACTIVE — it can fire from the q path, smartlog_tui's
    # function-scoped EXIT trap, and a signal, in any order.
    (( TUI_ACTIVE )) || return 0
    TUI_ACTIVE=0
    print -n -- $'\e[?25h\e[?7h\e[?1049l'
    [[ -n ${1:-} ]] && stty "$1" </dev/tty 2>/dev/null
    [[ -n $TUI_ERRF ]] && rm -f -- "$TUI_ERRF" 2>/dev/null
    return 0
}

function tui_readkey {
    # One keypress from /dev/tty into REPLY — or REPLY=resize when the
    # terminal changed size. Nonzero only when the tty itself is gone.
    # A timed poll, and that is load-bearing: SIGWINCH does NOT survive
    # read -k — zsh discards it around raw terminal reads (verified
    # empirically: neither a flag-raising TRAPWINCH, an in-trap repaint,
    # nor $LINES/$COLUMNS sees a resize while these reads run, though INT
    # does get through) — so the size is polled on each timeout instead of
    # trusted to the signal.
    local k= seq= ch= termsize=
    while ! read -sk1 -t 0.2 k </dev/tty; do
        { : <>/dev/tty; } 2>/dev/null || return 1
        termsize=$(stty size </dev/tty 2>/dev/null)
        if [[ $termsize == <->" "<-> ]] &&
           (( ${termsize%% *} != rows || ${termsize##* } != cols )); then
            REPLY=resize
            return 0
        fi
    done
    if [[ $k != $'\e' ]]; then
        REPLY=$k
        return 0
    fi
    # A lone Esc and the first byte of a sequence look identical; a 20ms
    # window tells them apart (a terminal sends the whole sequence at once).
    read -sk1 -t 0.02 ch </dev/tty || { REPLY=esc; return 0 }
    seq=$ch
    if [[ $ch == '[' || $ch == O ]]; then
        while read -sk1 -t 0.02 ch </dev/tty; do
            seq+=$ch
            [[ $ch == [A-Za-z~] ]] && break   # CSI final byte
        done
    fi
    case $seq in
        '[A'|OA)       REPLY=up ;;
        '[B'|OB)       REPLY=down ;;
        '[5~')         REPLY=pgup ;;
        '[6~')         REPLY=pgdn ;;
        '[H'|OH|'[1~') REPLY=home ;;
        '[F'|OF|'[4~') REPLY=end ;;
        *)             REPLY=other ;;
    esac
    return 0
}

function tui_render {
    # Fill buf with the render for the CURRENT flag tuple, memoized in cache
    # so toggling back to a seen tuple repaints instantly (r empties the
    # memo). smartlog_render runs inside $(...) deliberately: die's `exit`
    # kills only that subshell — the exit-inside-$() gotcha used as a sandbox
    # — so a failing toggle (--prs without gh, a base gone stale) lands its
    # first stderr line in msg instead of killing the screen. Reads and
    # writes smartlog_tui's locals (cache, buf, msg) and main's flag booleans
    # via dynamic scope.
    local key="$show_changes$show_branches$full$show_prs"
    msg=
    if [[ -z ${cache[$key]-} ]]; then
        local out= err= rc=0
        out=$(smartlog_render 2>| "$TUI_ERRF")
        rc=$?
        err=$(<"$TUI_ERRF")
        if (( rc )); then
            msg=${${err:-render failed}%%$'\n'*}
            return 1
        fi
        cache[$key]=$out
        [[ -n $err ]] && msg=${err%%$'\n'*}   # non-fatal warnings still show
    fi
    buf=("${(@f)cache[$key]}")
    return 0
}

function tui_draw {
    # Repaint: home, one buffer line per row, clear the rest, status line on
    # the bottom row, all in one write. No manual truncation — autowrap is
    # off (\e[?7l), so the terminal clips overlong lines at the right edge
    # while still PROCESSING escape sequences past it: a clipped line can't
    # bleed color or leave an OSC-8 hyperlink open, which byte-wise cutting
    # couldn't guarantee (it would split multibyte glyphs and OSC payloads).
    # Each row starts with \e[K so stale longer lines from the previous
    # frame can't show through.
    local -i view=$(( rows - 1 )) i=0
    (( view < 1 )) && view=1
    local frame=$'\e[H'
    for (( i = top; i < top + view && i <= ${#buf}; i++ )); do
        frame+=$'\e[K'"${buf[$i]}"$'\r\n'
    done
    frame+=$'\e[J'
    local -i last=$(( top + view - 1 ))
    (( last > ${#buf} )) && last=${#buf}
    # Status line: flag states (● on, ○ off, on-flags bold), scroll position,
    # key hints — or the pending message, which stays until the next key.
    local -a segs=()
    local seg=
    for seg in "c:changes:$show_changes" "b:branches:$show_branches" \
               "f:full:$full" "p:prs:$show_prs"; do
        local -a parts=(${(s.:.)seg})
        if (( parts[3] )); then
            segs+=($'\e[1m'"${parts[1]}:${parts[2]} ●"$'\e[22m')
        else
            segs+=("${parts[1]}:${parts[2]} ○")
        fi
    done
    local hints="j/k scroll  d/u page  g/G ends  r refresh  q quit"
    [[ -n $msg ]] && hints=$msg
    frame+=$'\e['"${rows};1H"$'\e[7m'" ${(j.  .)segs}  $top–$last/${#buf}  $hints"$'\e[m\e[K'
    print -n -- "$frame"
}

function smartlog_tui {
    # The interactive loop. Entry order matters:
    #   1. the first render happens BEFORE the alternate screen, so a bad
    #      --base or "Nothing to display" fails exactly like plain mode
    #      instead of flashing an empty TUI;
    #   2. raw mode is set ONCE for the session — read -sk restores cooked
    #      mode between calls, so keys typed during a ~1s render would
    #      otherwise echo garbage onto the frame;
    #   3. teardown is a function-scoped EXIT trap (zsh fires it when this
    #      function returns — the q path and any fall-through) plus signal
    #      traps that restore and exit ON THE SPOT: a trap that merely
    #      raised a flag would return into a silently restarted read, and
    #      the flag would sit unread until the next key.
    TAIL_CAP=${GIT_SMARTLOG_TUI_TAIL:-200}
    # Shadow main's prs_explicit so the p key can flip it session-local (a
    # toggle without gh should die into the status line, not warn), while
    # marker-driven PR tagging keeps its warn-and-carry-on entry behavior.
    local prs_explicit=$prs_explicit
    local -A cache=()
    local -a buf=()
    local msg=
    TUI_ERRF=$(git rev-parse --git-path "smartlog-tui-err.$$")
    # Sweep err files whose owner died uncleanly (SIGKILL outruns every
    # trap); the pid suffix says whose files are safe to take.
    local stale=
    for stale in ${TUI_ERRF:h}/smartlog-tui-err.<->(N); do
        kill -0 ${stale##*.} 2>/dev/null || rm -f -- "$stale" 2>/dev/null
    done

    if ! tui_render; then
        print -ru2 -- "${msg:-$PROG: render failed}"
        rm -f -- "$TUI_ERRF" 2>/dev/null
        return 1
    fi

    local -i rows=24 cols=80 top=1
    local termsize=
    termsize=$(stty size </dev/tty 2>/dev/null)
    if [[ $termsize == <->" "<-> ]]; then
        rows=${termsize%% *} cols=${termsize##* }
    fi

    local saved_stty=
    saved_stty=$(stty -g </dev/tty 2>/dev/null)
    trap 'tui_restore "$saved_stty"' EXIT
    # read -k runs in cbreak, not raw — ISIG stays on, so ^C really arrives
    # as SIGINT. Restore-and-exit right here; the EXIT trap that follows is
    # a no-op thanks to tui_restore's TUI_ACTIVE guard.
    trap 'tui_restore "$saved_stty"; exit 130' INT
    trap 'tui_restore "$saved_stty"; exit 143' TERM HUP
    stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null
    print -n -- $'\e[?1049h\e[?7l\e[?25l'
    TUI_ACTIVE=1

    local -i view=0 maxtop=0 was=0
    while true; do
        view=$(( rows - 1 ))
        (( view < 1 )) && view=1
        maxtop=$(( ${#buf} - view + 1 ))
        (( maxtop < 1 )) && maxtop=1
        (( top > maxtop )) && top=$maxtop
        (( top < 1 )) && top=1
        tui_draw
        # Only a dead tty fails the poll (INT/TERM restore-and-exit in
        # their traps; a resize comes back as a key) — leave cleanly.
        tui_readkey || break
        msg=
        case $REPLY in
            # ^C normally arrives as SIGINT (the INT trap above); the ^C/^D
            # byte forms only reach here if something upstream turned ISIG
            # off — cheap insurance against an unquittable screen.
            q|Q|$'\x03'|$'\x04') break ;;
            c|b|f|p)
                case $REPLY in
                    c) was=$show_changes; show_changes=$(( ! was )) ;;
                    b) was=$show_branches; show_branches=$(( ! was )) ;;
                    f) was=$full; full=$(( ! was )) ;;
                    p) was=$show_prs; show_prs=$(( ! was )); prs_explicit=1 ;;
                esac
                if [[ -z ${cache[$show_changes$show_branches$full$show_prs]-} ]]; then
                    msg="rendering…"
                    tui_draw
                fi
                if tui_render; then
                    top=1   # a different view is a different document
                else
                    # Revert the flip so the view matches the flags again;
                    # the failure text stays in msg for the next draw.
                    case $REPLY in
                        c) show_changes=$was ;;
                        b) show_branches=$was ;;
                        f) full=$was ;;
                        p) show_prs=$was ;;
                    esac
                fi
                ;;
            r)
                cache=()
                msg="rendering…"
                tui_draw
                tui_render
                ;;
            resize)
                termsize=$(stty size </dev/tty 2>/dev/null)
                if [[ $termsize == <->" "<-> ]]; then
                    rows=${termsize%% *}
                    if (( ${termsize##* } != cols )); then
                        # Stat bodies bake the width in at render time — a
                        # width change invalidates every cached render.
                        cols=${termsize##* }
                        cache=()
                        tui_render
                    fi
                fi
                ;;
            j|down)   top=$(( top + 1 )) ;;
            k|up)     top=$(( top - 1 )) ;;
            d)        top=$(( top + view / 2 )) ;;
            u)        top=$(( top - view / 2 )) ;;
            ' '|pgdn) top=$(( top + view )) ;;
            pgup)     top=$(( top - view )) ;;
            g|home)   top=1 ;;
            # ${#buf}, not maxtop — an in-trap resize can stale maxtop, and
            # the loop-top clamp brings this back into range either way.
            G|end)    top=${#buf} ;;
        esac
    done

    tui_restore "$saved_stty"
    return 0
}

# Multi-call dispatch on the invocation name: git-smartstat runs only the stat
# block, anything else (git-smartlog) runs the full smartlog — main parses,
# then pages the render (see run_paged; smartstat's block is short and feeds
# scripts, so it never pages).
case $PROG in
    git-smartstat|smartstat) smartstat_main "$@" ;;
    *)                       main "$@" ;;
esac
